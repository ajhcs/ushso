{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ushso",
  "account_id": "1e5f92087e779df50f3f3546a0eed22e",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "ushso.org/*",
      "zone_id": "2055535b187bf2c31209cecd90f38848"
    },
    {
      "pattern": "www.ushso.org/*",
      "zone_id": "2055535b187bf2c31209cecd90f38848"
    }
  ],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  }
}
