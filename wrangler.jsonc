{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ushso",
  "account_id": "1e5f92087e779df50f3f3546a0eed22e",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "ushso.org/*",
      "zone_id": "2055535b187bf2c31209cecd90f38848"
    },
    {
      "pattern": "www.ushso.org/*",
      "zone_id": "2055535b187bf2c31209cecd90f38848"
    }
  ],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "USHSO_DICTIONARY_REVIEW": "enabled",
    "USHSO_DICTIONARY_REVIEW_MANIFEST_SHA256": "0f10c6b764d054cd15324c4a1d93d6da191d86b792976d9573cdf27feceecb6b",
    "USHSO_SCIENTIFIC_REVIEW": "enabled",
    "USHSO_SCIENTIFIC_REVIEW_MANIFEST_SHA256": "533cd4c0ede0d6c39c19c16a9d8a3cb0161e3d51dc567c8b3826c2f1d04442df",
    "USHSO_SCIENTIFIC_CONFLICTS_REVIEW": "enabled",
    "USHSO_SCIENTIFIC_CONFLICTS_MANIFEST_SHA256": "2882d2d56d76a2a23123d54e83cec2d71519dc2bbead7cd7841e4bdeab5f858d"
  }
}
