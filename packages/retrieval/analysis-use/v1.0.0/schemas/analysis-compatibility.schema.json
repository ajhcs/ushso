{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ushso.org/retrieval/analysis-use/v1.0.0/analysis-compatibility.schema.json",
  "title": "Evidence-reviewed analytical compatibility assertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assertion_id",
    "analysis_id",
    "property_id",
    "requirement_catalog_sha256",
    "requirement_sha256",
    "record_ids",
    "state",
    "evidence_ids",
    "limitations",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": {"const": "observatory-analysis-compatibility.v1.0.0"},
    "assertion_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"},
    "analysis_id": {"$ref": "#/$defs/token"},
    "property_id": {"$ref": "#/$defs/token"},
    "requirement_catalog_sha256": {"$ref": "#/$defs/digest"},
    "requirement_sha256": {"$ref": "#/$defs/digest"},
    "record_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "state": {"enum": ["documented", "candidate", "unknown", "not_satisfied"]},
    "evidence_ids": {"$ref": "#/$defs/nonEmptyStringSet"},
    "limitations": {"$ref": "#/$defs/nonEmptyStringSet"},
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_type", "source_truth_separate", "field_inference_allowed"],
      "properties": {
        "assertion_type": {"const": "evidence_reviewed_compatibility_not_source_truth"},
        "source_truth_separate": {"const": true},
        "field_inference_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
