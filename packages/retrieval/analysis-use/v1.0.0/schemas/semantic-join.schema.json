{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ushso.org/retrieval/analysis-use/v1.0.0/semantic-join.schema.json",
  "title": "Evidence-reviewed semantic join for an analytical requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_join_id",
    "analysis_id",
    "requirement_catalog_sha256",
    "requirement_sha256",
    "join_requirement_id",
    "join_alternative_id",
    "route_id",
    "from_record_id",
    "to_record_id",
    "from_logical_endpoint",
    "to_logical_endpoint",
    "period_alignment",
    "from_key_input_ids",
    "to_key_input_ids",
    "from_field_refs",
    "to_field_refs",
    "evidence_ids",
    "limitations",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": {"const": "observatory-semantic-join.v1.0.0"},
    "semantic_join_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"},
    "analysis_id": {"$ref": "#/$defs/token"},
    "requirement_catalog_sha256": {"$ref": "#/$defs/digest"},
    "requirement_sha256": {"$ref": "#/$defs/digest"},
    "join_requirement_id": {"$ref": "#/$defs/token"},
    "join_alternative_id": {"$ref": "#/$defs/token"},
    "route_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"},
    "from_record_id": {"type": "string", "minLength": 1},
    "to_record_id": {"type": "string", "minLength": 1},
    "from_logical_endpoint": {"enum": ["left", "right"]},
    "to_logical_endpoint": {"enum": ["left", "right"]},
    "period_alignment": {"enum": ["documented", "candidate", "unknown", "not_applicable"]},
    "from_key_input_ids": {"$ref": "#/$defs/nonEmptyTokenSet"},
    "to_key_input_ids": {"$ref": "#/$defs/nonEmptyTokenSet"},
    "from_field_refs": {"$ref": "#/$defs/nonEmptyStringSet"},
    "to_field_refs": {"$ref": "#/$defs/nonEmptyStringSet"},
    "evidence_ids": {"$ref": "#/$defs/nonEmptyStringSet"},
    "limitations": {"$ref": "#/$defs/nonEmptyStringSet"},
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_type", "source_truth_separate", "field_inference_allowed"],
      "properties": {
        "assertion_type": {"const": "evidence_reviewed_join_not_source_truth"},
        "source_truth_separate": {"const": true},
        "field_inference_allowed": {"const": false}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "from_logical_endpoint": {"const": "left"},
        "to_logical_endpoint": {"const": "right"}
      }
    },
    {
      "properties": {
        "from_logical_endpoint": {"const": "right"},
        "to_logical_endpoint": {"const": "left"}
      }
    }
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nonEmptyTokenSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
