{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackyard.local/observatory/retrieval/v1.1.0/browser-record.schema.json",
  "title": "Browser inventory record with evidence-bound missing descriptions",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "title",
    "description",
    "authoritative_url",
    "identity",
    "geography",
    "time_coverage",
    "unit_of_analysis",
    "capabilities",
    "access",
    "provenance",
    "evidence",
    "freshness_verification",
    "retrieval",
    "join_compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": "observatory-record.v1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "dataset_asset"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "authoritative_url": {
      "type": "string",
      "format": "uri"
    },
    "identity": {
      "type": "object"
    },
    "geography": {
      "type": "object"
    },
    "time_coverage": {
      "type": "object"
    },
    "unit_of_analysis": {
      "type": "array"
    },
    "capabilities": {
      "type": "object"
    },
    "access": {
      "type": "object"
    },
    "provenance": {
      "type": "array",
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "freshness_verification": {
      "type": "object"
    },
    "retrieval": {
      "type": "object"
    },
    "join_compatibility": {
      "type": "object"
    }
  },
  "description": "Additive inventory compatibility. Empty descriptions require runtime native-identity and captured-evidence validation; they do not establish subject support or decision readiness."
}
