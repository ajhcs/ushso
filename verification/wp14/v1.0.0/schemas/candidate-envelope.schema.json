{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/wp14/candidate-envelope.v1.0.0.schema.json",
  "title": "WP14 exact candidate envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "candidate_class", "environment", "git", "release_gate", "artifact_pins", "artifact_pin_count", "candidate_content_manifest_sha256", "authorization_register_sha256", "component_gates", "fixture_topology", "execution_boundary", "runtime_boundary", "production_eligibility", "production_blockers", "candidate_digest_sha256"],
  "properties": {
    "schema_version": {"const": "ushso-wp14-candidate-envelope.v1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "candidate_class": {"enum": ["local_fixture_rehearsal", "production_release_candidate"]},
    "environment": {"type": "string", "minLength": 1, "maxLength": 80},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_commit", "head_tree_oid", "working_tree_status", "exact_candidate_tree_sealed", "note"],
      "properties": {
        "head_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "head_tree_oid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "working_tree_status": {"type": "string", "minLength": 1},
        "exact_candidate_tree_sealed": {"type": "boolean"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "policy_source", "plan_fingerprint_sha256", "status", "receipt_sha256", "reason"],
      "properties": {
        "authority": {"const": "local-exact-tree"},
        "policy_source": {"enum": ["detected", "repository-policy"]},
        "plan_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"type": "string", "minLength": 1},
        "receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "artifact_pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifact_pin_count": {"type": "integer", "minimum": 1},
    "candidate_content_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_register_sha256": {"$ref": "#/$defs/sha256"},
    "component_gates": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "fixture_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_version_n_minus_one", "worker_version_n", "static_emergency_worker_version", "search_generation_n_minus_one", "search_generation_n", "asset_bundle_n_minus_one_sha256", "asset_bundle_n_sha256", "static_artifact_sha256"],
      "properties": {
        "worker_version_n_minus_one": {"type": "string", "minLength": 1},
        "worker_version_n": {"type": "string", "minLength": 1},
        "static_emergency_worker_version": {"type": "string", "minLength": 1},
        "search_generation_n_minus_one": {"type": "string", "minLength": 1},
        "search_generation_n": {"type": "string", "minLength": 1},
        "asset_bundle_n_minus_one_sha256": {"$ref": "#/$defs/sha256"},
        "asset_bundle_n_sha256": {"$ref": "#/$defs/sha256"},
        "static_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_requests", "provider_mutations", "deployments", "public_requests", "source_requests", "payload_downloads", "analyses_executed", "raw_user_queries_persisted"],
      "properties": {
        "network_requests": {"const": 0},
        "provider_mutations": {"const": 0},
        "deployments": {"const": 0},
        "public_requests": {"const": 0},
        "source_requests": {"const": 0},
        "payload_downloads": {"const": 0},
        "analyses_executed": {"const": 0},
        "raw_user_queries_persisted": {"const": 0}
      }
    },
    "runtime_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_jsonl_loader_present", "stage_corpus_dependency_present", "jsonl_archives_retained", "static_emergency_artifact_deployable"],
      "properties": {
        "runtime_jsonl_loader_present": {"type": "boolean"},
        "stage_corpus_dependency_present": {"type": "boolean"},
        "jsonl_archives_retained": {"type": "boolean"},
        "static_emergency_artifact_deployable": {"type": "boolean"}
      }
    },
    "production_eligibility": {"type": "boolean"},
    "production_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "candidate_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [{
    "if": {"properties": {"candidate_class": {"const": "production_release_candidate"}}, "required": ["candidate_class"]},
    "then": {
      "properties": {
        "environment": {"const": "production"},
        "production_eligibility": {"const": true},
        "production_blockers": {"type": "array", "maxItems": 0},
        "git": {"type": "object", "properties": {"working_tree_status": {"const": "clean_exact_candidate"}, "exact_candidate_tree_sealed": {"const": true}}},
        "release_gate": {"type": "object", "properties": {"status": {"const": "PASS"}, "receipt_sha256": {"$ref": "#/$defs/sha256"}}}
      }
    }
  }],
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
