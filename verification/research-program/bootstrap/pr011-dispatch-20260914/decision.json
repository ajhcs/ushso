  "four_contract_decisions": [
    {
      "id": 1,
      "status": "adopted",
      "topic": "Exact fields/enums/length bounds, sanitized header/status evidence and actionable typed outcomes",
      "disposition": "Keep observation kinds catalog_metadata_validation, documentation_reachability, payload_validation, browser_cors_observation. Persist digests/references and bounded safe status/classification/detail-code only. Unknown remains null/typed unavailable, distinct from observed zero. No body/header/credential/free-form dumps."
    },
    {
      "id": 2,
      "status": "adopted",
      "topic": "Exact series key and durable attempt ordering",
      "disposition": "Series = source identity + descriptor/config/schema role if resolved + logical record/route identity + evidence kind + origin class. Execution attempt order comes from durable intent, not arrival time or caller timestamps. Late older completions cannot regress latest_attempt."
    },
    {
      "id": 3,
      "status": "adopted",
      "topic": "Evidence/terminal/replay ordering across crashes",
      "disposition": "Prefer projections from the one immutable journal stream. Never lose a latest failure, promote incomplete work to last-good, or redeliver an unknown intent. last_good is the greatest qualified success in the same series with exact proof references."
    },
    {
      "id": 4,
      "status": "adopted",
      "topic": "Composition-pinned authority for retained Census/EPA fixture evidence",
      "disposition": "Caller-supplied hashes never authenticate fresh success or broaden fixed collection admission. Census/EPA retained fixtures remain offline historical unresolved observations. Admission remains source_fixture_catalog / catalog.example.gov /data.json, one attempt per child."
    }
  ],
