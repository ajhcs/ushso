  "findings": [
    {
      "id": "PR010-LOCATOR-01",
      "priority": 2,
      "title": "Selected synthetic collector locator is rejected by the frozen connector allowlist",
      "proposal_location": "proposal.json /contracts/research_collector/fixture_locator and /contracts/fixture_scope/execution_descriptor; PROPOSAL.md:24",
      "evidence": [
        {
          "path": "packages/connectors/src/source-route-allowlist.mjs",
          "lines": [
            1,
            5,
            276,
            284,
            307,
            315
          ]
        },
        {
          "path": "packages/connectors/src/route-manifest.mjs",
          "lines": [
            248
          ]
        },
        {
          "path": "scripts/research/refresh.mjs",
          "lines": [
            11,
            28
          ]
        }
      ],
      "reason": "The only admitted fixture source is source_fixture_catalog. Its frozen host/route tuples use catalog.example.gov or mirror.example.gov and existing paths such as /data.json. Unknown source_fixture_* IDs have no positive allowlist. Therefore data.cdc.gov/__ushso_fixture__/catalog.json is rejected before the unchanged strict client can deliver the proposed actual collector bridge. This blocks A1/C1 and bounded C0102 under the stated preserved connector scope.",
      "original_finding_preserved": true,
      "remedy_status": "Root-suggested remedy assessed separately; not implemented or adopted by this review"
    }
  ],
  "remedy_assessment": {
    "viable_with_narrow_amendment": true,
    "exact_fixture_identity": "source_fixture_catalog",
    "exact_compiled_fixture_locator": "https://catalog.example.gov/data.json with only the selected approved cursor parameter",
    "capture_seam": "Add an explicit optional locator policy alongside the clock port within refresh.capture; default remains the exact existing metadataUrl function. The fixture composition supplies only an exact precompiled-locator guard and its injected fixture fetch bridge. Preserve the global legacy hostname allowlist and all frozen connector bytes.",
    "pairing": "A non-default locator policy requires an explicitly supplied own callable fetchImpl; omitted, undefined or invalid fetch is rejected before any fetch. It must not fall through to global fetch. The fixed fixture composition is independently tested for zero live ports; explicit injection alone is not proof a port is fixture-only.",
    "guard": "Validate guard result against the exact compiled locator and allowed cursor; both the capture guard and bridge reject foreign host/path/parameter/method and unadmitted descriptor identity. Do not introduce a CLI locator-policy or arbitrary URL option.",
    "authority": "Update both proposal and scope-amendment authority limits to cover only the capture locator-policy/clock seam and paired-port checks; the currently clock-only limit is insufficient.",
    "required_tests": [
      "Default capture calls and existing metadataUrl restrictions are unchanged.",
      "Custom policy without explicit callable fetch is rejected and cannot reach global fetch.",
      "Exact fixture compiled locator executes the actual capture function and consumes its returned result.",
      "Wrong locator, cursor, extra parameter or bridge identity blocks before transport.",
      "All original 29 proposed groups remain retained, with meaningful negative checks for the new guard."
    ]
  },
  "positive_assessments": [
    "Actual collector invocation and result consumption are now explicit; unused import or fabricated collector success is rejected.",
    "Both observed_at and recorded_at are captured before delivery and replayed, matching R2CaptureProtocol capture-reference identity.",
    "Whole scheduler transaction records preserve rollback; ambiguous after-memory-commit failures poison every adapter client and transport.",
    "Parent scheduling identity, child collection identity and child execution namespace are distinct; recovery explicitly locates committed parent/outbox instead of inferring absence from zero due runs.",
    "Tagged codec preserves array-versus-Map beginRun output, ordered entries and bounded byte references; raw JSON Map loss is prohibited.",
    "Disk journal and referenced objects are the persistence authority; memory stores are reducers and managed durability is unqualified.",
    "Fixed one-attempt settlement, unknown-intent no-redelivery, actual wrapper re-invocation from cached bytes and final checkpoint/intent commits are coherent at design level.",
    "PR009 receipt validator accepts coherent schema-valid synthetic records without activating its real-source policy; descriptor approval/digest resolution remains separately required."
  ],
  "implementation_conditions": [
    {
      "id": "IMPL-1",
      "condition": "Apply one explicitly pinned fixture clock to MemoryOriginGovernor as well as runner/client/capture ports; its default Date.now and private per-origin state are not durable journal state. Durable request/byte reservations remain the governing cross-restart fixture bounds; do not claim restored managed pacing/circuit history.",
      "source": "packages/connectors/src/origin-governor.mjs:9"
    },
    {
      "id": "IMPL-2",
      "condition": "The unchanged capture timer aborts its fetch signal, while BoundedHttpClient passes timeoutMs to transport. Fixture bridge/transport must honor bounded cancellation or settle a typed timeout without late success; a signal-ignoring hanging port is not bounded merely because its timer fires. No live timeout qualification is implied.",
      "source": "scripts/research/refresh.mjs:29; packages/connectors/src/bounded-http-client.mjs:236"
    },
    {
      "id": "IMPL-3",
      "condition": "Distinct execution IDs isolate run/pages/conditionals, but MemoryRunRepository memberships/checkpoints are keyed by sourceId. Make this sharing explicit as full synthetic source membership or partition reducer instances by child; retain child-specific checkpoint/result evidence and do not treat a source-level latest checkpoint as a child checkpoint.",
      "source": "packages/connectors/src/testing/memory-ports.mjs:90,204,259"
    },
    {
      "id": "IMPL-4",
      "condition": "Represent empty 304 bridge response with a null body and safe content type, preserve actual legacy http_failed/304 result, and reuse only verified prior capture/page with original provenance.",
      "source": "scripts/research/refresh.mjs:33,38"
    },
    {
      "id": "IMPL-5",
      "condition": "Regenerate final semantic source/import/schema/fixture/policy/runtime/lockfile pins after implementing the seam. Baseline closure hash agreement does not qualify the future implementation.",
      "source": "corrected-proposal/source-pins.json closure_limit"
    }
  ],
