{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackyard.local/observatory/retrieval/v1.0.0/join-route.schema.json",
  "title": "Explicit Observatory join route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_id","from_record_id","to_record_id","direction","entity","match_strategy","key_pairs",
    "cardinality","compatibility_state","confidence","preconditions","caveats","evidence_refs"
  ],
  "properties": {
    "route_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{2,127}$"},
    "from_record_id":{"type":"string","minLength":1},
    "to_record_id":{"type":"string","minLength":1},
    "direction":{"enum":["bidirectional","from_to","to_from"]},
    "entity":{"enum":["facility","hospital","provider","county","state","health_system","date","event","other","unknown"]},
    "match_strategy":{"enum":["exact_key","normalized_key","derived_geography","fallback_candidate","crosswalk_required","incompatible_without_crosswalk","unknown"]},
    "key_pairs":{
      "type":"array","minItems":1,"items":{
        "type":"object","additionalProperties":false,
        "required":["from_fields","to_fields","from_namespace","to_namespace","normalization_steps"],
        "properties":{
          "from_fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "to_fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "from_namespace":{"type":"string","minLength":1},
          "to_namespace":{"type":"string","minLength":1},
          "normalization_steps":{"type":"array","items":{"type":"string","minLength":1}}
        }
      }
    },
    "cardinality":{"enum":["one_to_one","one_to_many","many_to_one","many_to_many","unknown"]},
    "compatibility_state":{"enum":["documented","candidate","ambiguous","incompatible","unknown"]},
    "confidence":{"enum":["high","medium","low","unknown"]},
    "preconditions":{"type":"array","items":{"type":"string","minLength":1}},
    "caveats":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "evidence_refs":{
      "type":"array","minItems":1,"items":{
        "type":"object","additionalProperties":false,
        "required":["record_id","evidence_ids","provenance_ids","state"],
        "properties":{
          "record_id":{"type":"string","minLength":1},
          "evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "provenance_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "state":{"enum":["verified_first_party","source_asserted","inferred","unresolved","unavailable"]}
        }
      }
    },
    "blocked_reason":{"type":["string","null"]}
  }
}
