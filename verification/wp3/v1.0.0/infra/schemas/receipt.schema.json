{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/schemas/verification/wp3-infra-receipt.v1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "generated_at", "scope", "overall_status", "local_configuration", "managed_rehearsal", "non_claims"],
  "properties": {
    "schema_version": { "const": "ushso-wp3-infra-receipt.v1.0.0" },
    "receipt_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "minLength": 1 },
    "overall_status": { "const": "pending_external_authorization" },
    "local_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commands", "evidence", "input_sha256"],
      "properties": {
        "status": { "const": "pass" },
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "input_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "managed_rehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authorization_gates", "required_evidence"],
      "properties": {
        "status": { "const": "pending_external_authorization" },
        "authorization_gates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^AUTH-[0-9]{2}$" } },
        "required_evidence": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "authorization_boundaries": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "non_claims": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
  }
}
