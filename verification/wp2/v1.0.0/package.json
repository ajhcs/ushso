{
  "name": "@ushso/wp2-verification",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fail-closed aggregate verification gate for USHSO WP2 contracts and frozen evaluator artifacts.",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "scripts": {
    "manifest": "node tools/build-manifest.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "validate": "node tools/validate-wp2.mjs",
    "receipt": "node tools/validate-wp2.mjs --write-receipt"
  }
}
