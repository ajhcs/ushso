{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/evaluation/planner/audit-record.v1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_record_version", "question_id", "plan_status", "reason_codes", "dominant_reason_code",
    "precedence_valid", "essential_role_ids", "exact_selections", "measure_bindings", "coverage",
    "operations", "requirement_ids", "blocker_ids", "acquisition_steps", "clarification_question_ids",
    "schema_valid", "auditable_claims", "repeat_payload_equal", "repeat_digest_equal",
    "critical_claim_parity", "operation_graph_acyclic", "acquisition_graph_acyclic", "safety_violations"
  ],
  "properties": {
    "audit_record_version": {"const": "observatory-planner-evaluation-audit.v1.0.0"},
    "question_id": {"type": "string", "pattern": "^PLAN-V1-[DVH][0-9]{3}$"},
    "plan_status": {"enum": ["unsupported", "clarification_required", "incomplete", "ready_with_constraints", "ready"]},
    "reason_codes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
    "dominant_reason_code": {"type": "string", "minLength": 1, "maxLength": 96},
    "precedence_valid": {"type": "boolean"},
    "essential_role_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
    "exact_selections": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/selection"}},
    "measure_bindings": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["measure_id", "contribution_id"], "properties": {"measure_id": {"type": "string"}, "contribution_id": {"type": "string"}}}},
    "coverage": {"type": "object"},
    "operations": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "requirement_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
    "blocker_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
    "acquisition_steps": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
    "clarification_question_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
    "schema_valid": {"type": "boolean"},
    "auditable_claims": {
      "description": "backed counts only claims whose evidence resolves and is admissible, current under policy, reviewed when required, observation-timestamped, and lineage-complete.",
      "type": "object", "additionalProperties": false, "required": ["backed", "total"],
      "properties": {"backed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}
    },
    "repeat_payload_equal": {"type": "boolean"},
    "repeat_digest_equal": {"type": "boolean"},
    "critical_claim_parity": {"type": "boolean"},
    "operation_graph_acyclic": {"type": "boolean"},
    "acquisition_graph_acyclic": {"type": "boolean"},
    "safety_violations": {"type": "array", "maxItems": 32, "items": {"type": "string"}}
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "release_id", "distribution_id", "access_route_id", "source_id"],
      "properties": {
        "asset_id": {"type": "string"},
        "release_id": {"type": "string"},
        "distribution_id": {"type": "string"},
        "access_route_id": {"type": "string"},
        "source_id": {"type": "string"}
      }
    }
  }
}
