{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/evaluation/planner/gold-record.v1.0.0.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/status"},
    {"$ref": "#/$defs/roles"},
    {"$ref": "#/$defs/assets"},
    {"$ref": "#/$defs/bindings"},
    {"$ref": "#/$defs/operations"},
    {"$ref": "#/$defs/requirements"},
    {"$ref": "#/$defs/coverageRecord"},
    {"$ref": "#/$defs/dag"},
    {"$ref": "#/$defs/clarifications"}
  ],
  "$defs": {
    "questionId": {"type": "string", "pattern": "^PLAN-V1-[DVH][0-9]{3}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 240},
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "plan_status", "reason_codes", "dominant_reason_code", "precedence_index"],
      "properties": {
        "question_id": {"$ref": "#/$defs/questionId"},
        "plan_status": {"enum": ["unsupported", "clarification_required", "incomplete", "ready_with_constraints", "ready"]},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "dominant_reason_code": {"$ref": "#/$defs/identifier"},
        "precedence_index": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "roles": {
      "type": "object", "additionalProperties": false, "required": ["question_id", "essential_roles"],
      "properties": {
        "question_id": {"$ref": "#/$defs/questionId"},
        "essential_roles": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["role_id", "role_kind", "essential", "contribution_id", "provenance_label"], "properties": {
          "role_id": {"$ref": "#/$defs/identifier"},
          "role_kind": {"enum": ["ownership_change", "utilization", "finance", "denominator", "organization_identity", "geography", "crosswalk", "clinical_context", "workforce", "other"]},
          "essential": {"const": true},
          "contribution_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
          "provenance_label": {"type": "string", "minLength": 1, "maxLength": 500}
        }}}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["contribution_id", "role_id", "asset_id", "release_id", "distribution_id", "access_route_id", "source_id", "access_class"],
      "properties": {
        "contribution_id": {"$ref": "#/$defs/identifier"}, "role_id": {"$ref": "#/$defs/identifier"},
        "asset_id": {"$ref": "#/$defs/identifier"}, "release_id": {"$ref": "#/$defs/identifier"},
        "distribution_id": {"$ref": "#/$defs/identifier"}, "access_route_id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "access_class": {"enum": ["public", "registration", "application", "dua", "licensed", "paid", "report_only", "unknown"]}
      }
    },
    "assets": {
      "type": "object", "additionalProperties": false, "required": ["question_id", "exact_selections"],
      "properties": {"question_id": {"$ref": "#/$defs/questionId"}, "exact_selections": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/selection"}}}
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["measure_id", "contribution_id"],
      "properties": {"measure_id": {"$ref": "#/$defs/identifier"}, "contribution_id": {"$ref": "#/$defs/identifier"}}
    },
    "bindings": {
      "type": "object", "additionalProperties": false, "required": ["question_id", "bindings"],
      "properties": {"question_id": {"$ref": "#/$defs/questionId"}, "bindings": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/binding"}}}
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "operation_kind", "evidence_state", "basis_evidence_state", "compatibility"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/identifier"},
        "operation_kind": {"enum": ["join", "crosswalk", "aggregate", "filter", "temporal_alignment", "measure_harmonization"]},
        "evidence_state": {"enum": ["unknown", "candidate", "ambiguous", "documented", "observed", "executed", "proven"]},
        "basis_evidence_state": {"enum": ["unknown", "candidate", "ambiguous", "documented", "observed", "executed", "proven"]},
        "compatibility": {"enum": ["compatible", "conditional", "incompatible", "unknown"]}
      }
    },
    "operations": {
      "type": "object", "additionalProperties": false, "required": ["question_id", "operations"],
      "properties": {"question_id": {"$ref": "#/$defs/questionId"}, "operations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/operation"}}}
    },
    "requirements": {
      "type": "object", "additionalProperties": false, "required": ["question_id", "requirement_ids", "blocker_ids"],
      "properties": {
        "question_id": {"$ref": "#/$defs/questionId"},
        "requirement_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "blocker_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "period": {
      "type": "object", "additionalProperties": false, "required": ["start", "end", "period_kind"],
      "properties": {"start": {"type": ["string", "null"], "maxLength": 32}, "end": {"type": ["string", "null"], "maxLength": 32}, "period_kind": {"enum": ["calendar", "fiscal", "mixed", "unknown"]}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["period", "geographies"],
      "properties": {"period": {"$ref": "#/$defs/period"}, "geographies": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}}, "state": {"enum": ["supported", "partial", "conditional", "blocked", "unknown"]}, "contribution_id": {"$ref": "#/$defs/identifier"}}
    },
    "coverageRecord": {
      "type": "object", "additionalProperties": false, "required": ["question_id", "coverage"],
      "properties": {"question_id": {"$ref": "#/$defs/questionId"}, "coverage": {"type": "object", "additionalProperties": false, "required": ["requested", "source_supported", "common_supported", "method"], "properties": {
        "requested": {"$ref": "#/$defs/coverage"},
        "source_supported": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/coverage"}},
        "common_supported": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/coverage"}]},
        "method": {"const": "intersection"}
      }}}
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "action_kind", "depends_on", "stop_condition", "human_gate", "access_route_id"],
      "properties": {
        "step_id": {"$ref": "#/$defs/identifier"},
        "action_kind": {"enum": ["prepare_inputs", "registration", "application", "dua", "fee", "institutional_approval", "retrieve_from_source", "verify_artifact"]},
        "depends_on": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "stop_condition": {"type": "string", "minLength": 1, "maxLength": 1000},
        "human_gate": {"type": "boolean"},
        "access_route_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "dag": {
      "type": "object", "additionalProperties": false, "required": ["question_id", "steps", "complete"],
      "properties": {"question_id": {"$ref": "#/$defs/questionId"}, "steps": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/step"}}, "complete": {"type": "boolean"}}
    },
    "clarifications": {
      "type": "object", "additionalProperties": false, "required": ["question_id", "material_question_ids"],
      "properties": {"question_id": {"$ref": "#/$defs/questionId"}, "material_question_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}
    }
  }
}
