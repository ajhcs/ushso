{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human review queue item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "priority",
    "status",
    "question_ids",
    "source_record_ids",
    "review_action",
    "reason",
    "blocking_if_unresolved",
    "evidence_references"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "status": {
      "const": "open"
    },
    "question_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_action": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "blocking_if_unresolved": {
      "type": "boolean"
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
