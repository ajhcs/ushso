{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark statistics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statistics_version",
    "generated_at",
    "external_requests",
    "question_count",
    "question_composition",
    "response_type_composition",
    "split_counts",
    "judgment_counts",
    "bundle_counts",
    "difficulty_profile",
    "feature_coverage",
    "seed_coverage",
    "human_review_count",
    "prohibited_action_attestation"
  ],
  "properties": {
    "statistics_version": {
      "const": "question-to-data-statistics.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "external_requests": {
      "const": 0
    },
    "question_count": {
      "const": 60
    },
    "question_composition": {
      "type": "object",
      "additionalProperties": true
    },
    "response_type_composition": {
      "type": "object",
      "additionalProperties": true
    },
    "split_counts": {
      "type": "object",
      "additionalProperties": true
    },
    "split_geography_counts": {
      "type": "object",
      "additionalProperties": true
    },
    "judgment_counts": {
      "type": "object",
      "additionalProperties": true
    },
    "bundle_counts": {
      "type": "object",
      "additionalProperties": true
    },
    "difficulty_profile": {
      "type": "object",
      "additionalProperties": true
    },
    "feature_coverage": {
      "type": "object",
      "additionalProperties": true
    },
    "seed_coverage": {
      "type": "object",
      "additionalProperties": true
    },
    "human_review_count": {
      "type": "integer",
      "minimum": 0
    },
    "prohibited_action_attestation": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
