{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Existing project source reference index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index_version",
    "generated_at",
    "external_requests",
    "source_reference_count",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "index_version": {
      "const": "question-to-data-source-reference.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "external_requests": {
      "const": 0
    },
    "source_reference_count": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
