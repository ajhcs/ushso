{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USHSO retrieval evaluator v2 input",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_version", "run_id", "lane_id", "pins", "k_values", "cases"],
  "properties": {
    "input_version": {"const": "ushso-retrieval-evaluator-input.v2.0.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "lane_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corpus_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "content_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "records_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "search_documents_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "vocabulary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "algorithm_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "benchmark_pin_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cohort_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "metric_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["corpus_manifest_sha256", "content_fingerprint_sha256", "records_sha256", "search_documents_sha256", "vocabulary_sha256", "algorithm_fingerprint_sha256", "benchmark_pin_sha256", "cohort_manifest_sha256", "metric_contract_sha256"]
    },
    "k_values": {"const": [1, 3, 5, 10, 20]},
    "cases": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "result_bundle"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "result_bundle": {"type": "object"}
        }
      }
    }
  }
}
