{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USHSO retrieval evaluator v2 report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "evaluator_version", "run_id", "lane_id", "generated_at", "pins", "k_values", "question_count", "split_counts", "cohort_breakdown", "metrics", "safety", "question_evaluations", "execution_boundary"],
  "properties": {
    "report_version": {"const": "ushso-retrieval-evaluation-report.v2.0.0"},
    "evaluator_version": {"const": "ushso-retrieval-evaluator.v2.0.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "lane_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "generated_at": {"const": "2026-08-30T00:00:00.000Z"},
    "pins": {"type": "object"},
    "k_values": {"const": [1, 3, 5, 10, 20]},
    "question_count": {"type": "integer", "minimum": 1, "maximum": 60},
    "split_counts": {"type": "object"},
    "cohort_breakdown": {"type": "object"},
    "metrics": {"type": "object"},
    "safety": {"type": "object"},
    "question_evaluations": {"type": "array", "minItems": 1, "maxItems": 60, "items": {"type": "object"}},
    "execution_boundary": {"type": "object"}
  }
}
