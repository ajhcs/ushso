{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "package_id", "version", "created_at", "hash_algorithm", "manifest_excludes", "file_count", "payload_bytes", "files", "offline", "external_requests", "ranking_optimization_performed", "llm_used", "identity_work_performed", "coverage_execution_performed", "heavy_analysis_lock_touched", "immutable"],
  "properties": {
    "manifest_version": { "const": "o8-evaluation-harness-package-manifest.v1" },
    "package_id": { "const": "o8-evaluation-harness-v1.0.0" },
    "version": { "const": "1.0.0" },
    "created_at": { "type": "string", "minLength": 1 },
    "hash_algorithm": { "const": "sha256" },
    "manifest_excludes": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "file_count": { "type": "integer", "minimum": 1 },
    "payload_bytes": { "type": "integer", "minimum": 1 },
    "files": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "offline": { "const": true }, "external_requests": { "const": 0 }, "ranking_optimization_performed": { "const": false }, "llm_used": { "const": false }, "identity_work_performed": { "const": false }, "coverage_execution_performed": { "const": false }, "heavy_analysis_lock_touched": { "const": false }, "immutable": { "const": true }
  }
}
