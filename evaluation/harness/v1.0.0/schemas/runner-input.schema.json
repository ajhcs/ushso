{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O8 deterministic evaluation runner input",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_version", "run_id", "benchmark_package", "k_values", "cases"],
  "properties": {
    "input_version": { "const": "o8-evaluation-runner-input.v1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1 },
    "benchmark_package": { "const": "ushso-question-to-data-v0.1.0" },
    "k_values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 100 } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "intent_compilation", "result_bundle"],
        "properties": {
          "question_id": { "type": "string", "minLength": 1 },
          "intent_compilation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question_id", "research_intent", "required_measures", "excluded_measures", "geography", "geographic_granularity", "time_period", "unit_of_analysis", "required_access", "authoritative_source_requirement", "expected_response_type", "clarification_needed"],
            "properties": {
              "question_id": { "type": "string", "minLength": 1 },
              "research_intent": { "type": "object" },
              "required_measures": { "type": "array", "items": { "type": "string" } },
              "excluded_measures": { "type": "array", "items": { "type": "string" } },
              "geography": { "type": "object" },
              "geographic_granularity": { "type": "string", "minLength": 1 },
              "time_period": { "type": "object" },
              "unit_of_analysis": { "type": "object" },
              "required_access": { "type": "object" },
              "authoritative_source_requirement": { "type": "object" },
              "expected_response_type": { "enum": ["single_source", "multi_source_bundle", "clarification_required", "unsupported_or_incomplete"] },
              "clarification_needed": { "type": "boolean" }
            }
          },
          "result_bundle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result_state", "results", "important_restrictions", "join_routes", "zero_result"],
            "properties": {
              "result_state": { "enum": ["results", "zero_results"] },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["rank", "source_record_id", "recommendation_state", "access_implications", "provenance_references"],
                  "properties": {
                    "rank": { "type": "integer", "minimum": 1 },
                    "source_record_id": { "type": "string", "minLength": 1 },
                    "recommendation_state": { "enum": ["recommended", "mentioned_as_limitation"] },
                    "access_implications": { "type": "string", "minLength": 1 },
                    "provenance_references": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["artifact_path", "locator"],
                        "properties": {
                          "artifact_path": { "type": "string", "minLength": 1 },
                          "locator": { "type": "string", "minLength": 1 },
                          "evidence_id": { "type": "string", "minLength": 1 }
                        }
                      }
                    }
                  }
                }
              },
              "important_restrictions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "join_routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_record_ids", "status", "crosswalk_ids", "provenance_references"],
                  "properties": {
                    "source_record_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "status": { "enum": ["join_proven", "join_documented", "join_candidate", "join_requires_crosswalk", "incompatible_grain", "incompatible_time", "incompatible_geography", "unknown"] },
                    "crosswalk_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "provenance_references": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["artifact_path", "locator"],
                        "properties": {
                          "artifact_path": { "type": "string", "minLength": 1 },
                          "locator": { "type": "string", "minLength": 1 },
                          "evidence_id": { "type": "string", "minLength": 1 }
                        }
                      }
                    }
                  }
                }
              },
              "zero_result": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["reason_code", "scope", "corpus_absence_claimed", "statement"],
                "properties": {
                  "reason_code": { "enum": ["no_match_in_evaluated_result_set", "retrieval_not_run", "retrieval_error"] },
                  "scope": { "const": "evaluated_result_set_only" },
                  "corpus_absence_claimed": { "type": "boolean" },
                  "statement": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
