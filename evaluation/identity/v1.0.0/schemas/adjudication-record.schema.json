{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/evaluation/identity/v1.0.0/adjudication-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "reviewer_packet_byte_sha256",
    "review_case_id",
    "reviewer_id",
    "reviewer_identity_receipt_id",
    "independence_attestation_id",
    "review_role",
    "human",
    "decision",
    "rationale",
    "evidence_reference_ids",
    "reviewed_at",
    "review_receipt_id",
    "review_evidence_status"
  ],
  "properties": {
    "schema_version": {"const": "identity.benchmark-adjudication.v1.0.0"},
    "packet_id": {"type": "string", "pattern": "^identity-review-packet:"},
    "reviewer_packet_byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_case_id": {"type": "string", "pattern": "^review-case:[0-9a-f]{32}$"},
    "reviewer_id": {"type": "string", "pattern": "^reviewer:[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "reviewer_identity_receipt_id": {"type": "string", "pattern": "^receipt:[A-Za-z0-9][A-Za-z0-9._:-]{2,191}$"},
    "independence_attestation_id": {"type": "string", "pattern": "^attestation:[A-Za-z0-9][A-Za-z0-9._:-]{2,187}$"},
    "review_role": {"enum": ["primary", "secondary", "adjudicator"]},
    "human": {"const": true},
    "decision": {"enum": ["same_identity", "not_same_identity", "needs_more_evidence"]},
    "rationale": {"type": "string", "minLength": 20, "maxLength": 2000},
    "evidence_reference_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 200}
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "review_receipt_id": {"type": "string", "pattern": "^review-receipt:[A-Za-z0-9][A-Za-z0-9._:-]{2,183}$"},
    "review_evidence_status": {"const": "externally_verified_human_review"}
  }
}
