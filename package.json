{
  "name": "ushso",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*",
    "packages/*/*/v*",
    "contracts/*/v*",
    "docs/feedback/v*",
    "evaluation/*/v*",
    "verification/*/v*",
    "verification/testing/*/v*"
  ],
  "scripts": {
    "harvest:catalog": "node scripts/harvest-live-catalog.mjs",
    "test:catalog": "node --test tests/live-catalog-candidate.test.mjs tests/static-machine-toolkit.test.mjs",
    "verify:catalog-runtime": "npm run build && node --expose-gc scripts/check-live-catalog-runtime.mjs",
    "verify:webmcp-native": "node scripts/check-webmcp-native.mjs",
    "import:national": "node scripts/import-national-federal-evidence.mjs",
    "import:readiness": "node scripts/import-state-readiness.mjs",
    "build:national": "node packages/retrieval/tools/build-national-successor.mjs --fixture",
    "validate:national": "node packages/retrieval/tools/validate-national-successor.mjs",
    "stage:corpus": "node scripts/stage-corpus.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "test:retrieval": "npm test --workspace @ushso/observatory-retrieval",
    "test:web": "npm test --workspace @ushso/observatory-web",
    "test:worker": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e-smoke.mjs",
    "test:evaluation": "node --test evaluation/baseline/v0.1.0/tests/*.test.mjs",
    "validate:evaluation": "node evaluation/baseline/v0.1.0/tools/validate-baseline.mjs",
    "test:contracts": "node scripts/run-contract-suites.mjs --contracts",
    "test:evaluator-v2": "node scripts/run-contract-suites.mjs --suite evaluator-v2",
    "test:evaluator-bridge": "node scripts/run-contract-suites.mjs --suite evaluator-bridge",
    "test:feedback": "node scripts/run-contract-suites.mjs --suite feedback",
    "test:wp0": "node scripts/run-contract-suites.mjs --suite wp0",
    "test:wp2": "node scripts/run-contract-suites.mjs --suite wp2",
    "test:program-verification": "node scripts/run-contract-suites.mjs --suite program-verification",
    "test:external-authorization": "node scripts/run-contract-suites.mjs --suite external-authorization",
    "test:ci-verification": "node scripts/run-contract-suites.mjs --suite ci-verification",
    "test:verification": "node scripts/run-contract-suites.mjs --verification",
    "verify:research-navigator": "node scripts/run-contract-suites.mjs --all",
    "test": "npm run test:retrieval && npm run test:web && npm run test:worker && npm run test:evaluation && npm run validate:evaluation && npm run verify:research-navigator",
    "build:web": "npm run stage:corpus && npm run build --workspace @ushso/observatory-web",
    "build": "npm run build:web",
    "cf:types": "node scripts/run-wrangler.mjs types",
    "cf:dry-run:artifact": "node scripts/run-wrangler.mjs deploy --dry-run --outdir .wrangler-dry-run",
    "cf:dry-run": "npm run build && npm run cf:dry-run:artifact",
    "cf:dev": "node scripts/run-wrangler.mjs dev --local --port 8787",
    "cf:deploy:staging": "npm run build && node scripts/run-wrangler.mjs deploy --config wrangler.staging.jsonc",
    "cf:deploy": "npm run build && node scripts/run-wrangler.mjs deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
