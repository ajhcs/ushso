# AUTH-02: replace through the approved encrypted remote-state bootstrap.
# This example is inert and contains no account ID, endpoint, or credential.
bucket       = "REPLACE_STAGING_STATE_BUCKET"
key          = "ushso/staging/wp3-foundation.tfstate"
region       = "auto"
encrypt      = true
use_lockfile = true

# Supply the S3-compatible endpoint and credentials outside source control.
# endpoints = { s3 = "REPLACE_STAGING_STATE_ENDPOINT" }
