# AUTH-11 follows AUTH-02/AUTH-03 staging acceptance. This state must be a
# distinct encrypted bucket/key and must never reuse staging credentials.
bucket       = "REPLACE_PRODUCTION_STATE_BUCKET"
key          = "ushso/production/wp3-foundation.tfstate"
region       = "auto"
encrypt      = true
use_lockfile = true

# Supply the S3-compatible endpoint and credentials outside source control.
# endpoints = { s3 = "REPLACE_PRODUCTION_STATE_ENDPOINT" }
