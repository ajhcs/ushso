{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "ushso-staging-ops",
  "main": "../../templates/foundation-placeholder.mjs",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "workers_dev": false,
  "routes": [],
  "vars": {
    "USHSO_ENVIRONMENT": "staging",
    "USHSO_WORKER_ROLE": "ops",
    "FOUNDATION_INERT": "true",
    "CONFIG_SCHEMA_VERSION": "ushso-worker-binding-manifest.v1.0.0"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "hyperdrive": [
    {
      "binding": "HD_CORRECTNESS",
      "id": "REPLACE_STAGING_OPS_HD_CORRECTNESS_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_ARCHIVE",
      "bucket_name": "ushso-staging-archive"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "HARVEST_PAGE_QUEUE",
        "queue": "ushso-staging-harvest-page"
      },
      {
        "binding": "NORMALIZE_RECORD_QUEUE",
        "queue": "ushso-staging-normalize-record"
      },
      {
        "binding": "ENRICH_SCHEMA_QUEUE",
        "queue": "ushso-staging-enrich-schema"
      },
      {
        "binding": "ACCESS_CHECK_QUEUE",
        "queue": "ushso-staging-access-check"
      },
      {
        "binding": "PROJECT_INDEX_QUEUE",
        "queue": "ushso-staging-project-index"
      }
    ],
    "consumers": [
      {
        "queue": "ushso-staging-harvest-page-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 30
      },
      {
        "queue": "ushso-staging-normalize-record-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 30
      },
      {
        "queue": "ushso-staging-enrich-schema-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 30
      },
      {
        "queue": "ushso-staging-access-check-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 30
      },
      {
        "queue": "ushso-staging-project-index-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 30
      }
    ]
  },
  "workflows": [
    {
      "binding": "HARVEST_WORKFLOW",
      "name": "ushso-staging-harvest",
      "class_name": "HarvestWorkflow",
      "script_name": "ushso-staging-scheduler"
    }
  ]
}
