{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "ushso-production-normalize",
  "main": "../../templates/foundation-placeholder.mjs",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "workers_dev": false,
  "routes": [],
  "vars": {
    "USHSO_ENVIRONMENT": "production",
    "USHSO_WORKER_ROLE": "normalize",
    "FOUNDATION_INERT": "true",
    "CONFIG_SCHEMA_VERSION": "ushso-worker-binding-manifest.v1.0.0"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "hyperdrive": [
    {
      "binding": "HD_CORRECTNESS",
      "id": "REPLACE_PRODUCTION_NORMALIZE_HD_CORRECTNESS_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_CAPTURE",
      "bucket_name": "ushso-production-capture"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ENRICH_SCHEMA_QUEUE",
        "queue": "ushso-production-enrich-schema"
      },
      {
        "binding": "ACCESS_CHECK_QUEUE",
        "queue": "ushso-production-access-check"
      },
      {
        "binding": "PROJECT_INDEX_QUEUE",
        "queue": "ushso-production-project-index"
      }
    ],
    "consumers": [
      {
        "queue": "ushso-production-normalize-record",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 4,
        "dead_letter_queue": "ushso-production-normalize-record-dlq",
        "max_concurrency": 2
      },
      {
        "queue": "ushso-production-enrich-schema",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "ushso-production-enrich-schema-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "ushso-production-access-check",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "ushso-production-access-check-dlq",
        "max_concurrency": 1
      }
    ]
  }
}
