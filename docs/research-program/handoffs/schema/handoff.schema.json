{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/schemas/research-program/handoff.v1.schema.json",
  "title": "ushso implementer handoff and review receipt",
  "description": "Machine-checkable contract for an implementer handoff/receipt. It preserves exact base/head/dependency SHAs, owned-file and changed-behavior statements, command/exit records, fixture expected/actual observations, artifact hashes, risks, failures and the next consumer. Derived from docs/master-plan/2026-09-10/EXECUTION.md ('Communication and retained notes') and the PR-003 packet. A success claim without a command result is not acceptable evidence; the bounded C-003-1 checker and the C-003-2 validator enforce the cross-reference rules that JSON Schema alone cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "pr_id",
    "status",
    "owner",
    "reviewer",
    "base_sha",
    "head_sha",
    "dependency_merge_shas",
    "branch",
    "changed_files",
    "problem",
    "resulting_behavior",
    "commits",
    "source_identities",
    "commands",
    "artifacts",
    "acceptance_results",
    "failures_and_skipped_checks",
    "unresolved_claims",
    "risks",
    "next_consumer",
    "next_action",
    "independent_review"
  ],
  "properties": {
    "format": { "const": "ushso.pr-handoff.v1" },
    "pr_id": { "$ref": "#/$defs/prId" },
    "status": { "type": "string", "minLength": 1 },
    "owner": { "$ref": "#/$defs/nullableString" },
    "reviewer": { "type": "string", "minLength": 1 },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "head_sha": { "$ref": "#/$defs/nullableGitSha" },
    "dependency_merge_shas": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/prId" },
      "additionalProperties": { "$ref": "#/$defs/gitSha" }
    },
    "branch": { "type": "string", "pattern": "^codex/[A-Za-z0-9._/-]+$" },
    "github_pr_url": { "$ref": "#/$defs/nullableUrl" },
    "changed_files": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "problem": { "type": "string", "minLength": 1 },
    "resulting_behavior": { "type": "string", "minLength": 1 },
    "commits": {
      "type": "array",
      "items": { "$ref": "#/$defs/commitRef" }
    },
    "source_identities": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceIdentity" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "acceptance_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptanceResult" }
    },
    "failures_and_skipped_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "unresolved_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "next_consumer": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "independent_review": { "$ref": "#/$defs/independentReview" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "prId": { "type": "string", "pattern": "^PR-[0-9]{3}$" },
    "nullableString": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "nullableGitSha": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
    "nullableUrl": {
      "oneOf": [
        { "type": "string", "pattern": "^https://github\\.com/" },
        { "type": "null" }
      ]
    },
    "acceptanceState": {
      "description": "Typed outcome for one acceptance slice. 'passed', 'producer_checked' and 'independently_verified' are success claims and therefore require at least one command result. 'blocked', 'unavailable' and 'unresolved' are preserved as non-pass states, never coerced to success.",
      "enum": [
        "pending",
        "blocked",
        "unavailable",
        "unresolved",
        "failed",
        "passed",
        "producer_checked",
        "independently_verified"
      ]
    },
    "commitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject"],
      "properties": {
        "id": { "type": "string", "pattern": "^C-[0-9]{3}-[0-9]+$" },
        "subject": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/nullableGitSha" }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "description": "One executed command with its typed result. A numeric exit code is recorded only when actually observed; providers that do not expose one use an explicit completion_status instead (never an invented exit).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "result"],
      "properties": {
        "id": { "type": "string", "pattern": "^cmd-[A-Za-z0-9._-]+$" },
        "command": { "type": "string", "minLength": 1 },
        "started_at": { "$ref": "#/$defs/nullableString" },
        "completed_at": { "$ref": "#/$defs/nullableString" },
        "exit_code": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
        "completion_status": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 },
        "event_source": { "$ref": "#/$defs/artifact" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "acceptanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "result", "command_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/acceptanceState" },
        "result": { "type": "string", "minLength": 1 },
        "command_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["passed", "producer_checked", "independently_verified"] } },
            "required": ["status"]
          },
          "then": {
            "properties": { "command_ids": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "detail"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["failed", "skipped", "blocked", "unavailable", "unresolved", "open", "risk", "accepted"]
        },
        "detail": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "independentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_head_sha", "decisive_checks", "limitations"],
      "properties": {
        "status": {
          "enum": ["not_started", "in_review", "changes_requested", "independently_verified"]
        },
        "reviewed_head_sha": { "$ref": "#/$defs/nullableGitSha" },
        "decisive_checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
