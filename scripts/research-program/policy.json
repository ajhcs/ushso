{
  "policy_version": "ushso.research-program.operating-bounds.v1.0.0",
  "lifecycle": "fixture_only",
  "external_authorization_gate": "AUTH-04",
  "activation": {
    "live_network": false,
    "receipt_writes": false,
    "database_writes": false,
    "queue_activation": false,
    "workflow_activation": false,
    "deletion_activation": false,
    "source_egress": false,
    "activation_authorized": false
  },
  "descriptor_identity": {
    "hash_algorithm": "sha256",
    "hash_basis": "ushso-canonical-json.v1",
    "hash_version": "ushso-canonical-json.v1",
    "encoding": "utf-8",
    "object_key_order": "recursively_sorted",
    "array_order": "preserved",
    "distinct_from_exact_published_bytes": true,
    "registry_source_revisions_descriptor_sha256": "unresolved_no_insertion_invariant",
    "job_identity_rule": "Carry a registered lowercase 64-hex digest unchanged only when its named hash_basis is ushso-canonical-json.v1. Never derive a digest from configuration_revision or a source/endpoint/revision tuple."
  },
  "forbidden_operation_classes": [
    "source_data_payload",
    "query_execution",
    "data_download",
    "archive_member",
    "form_submission",
    "login",
    "payment",
    "authorization_workflow",
    "arbitrary_url",
    "secret_in_policy_or_receipt",
    "unbounded_file",
    "unapproved_redirect"
  ],
  "global_bounds": {
    "timeout_seconds": 30,
    "maximum_redirects": 1,
    "structural_response_limits": {
      "maximum_response_depth": 32,
      "maximum_response_nodes": 20000,
      "maximum_records": 1000,
      "maximum_links": 1000,
      "maximum_observations": 1000
    },
    "retry": {
      "stage": "harvest_page",
      "maximum_delivery_attempts": 6,
      "transport_max_retries": 5,
      "minimum_delay_seconds": 5,
      "maximum_delay_seconds": 900,
      "exhausted_outcome": "durable_dlq_and_partial_unpublished"
    },
    "dlq": {
      "policy_version": "dlq-sink.v1",
      "maximum_delivery_attempts": 6,
      "transport_max_retries": 5,
      "maximum_batch_size": 1,
      "minimum_delay_seconds": 30,
      "maximum_delay_seconds": 300,
      "second_dead_letter_queue_allowed": false
    },
    "retention": {
      "raw_metadata_documentation_active_days": 90,
      "security_and_audit_receipt_days": 365,
      "queue_transport_days": 4,
      "hashes_and_lineage_outlive_raw": true
    },
    "aggregate_sample_store": "disabled_pending_rights_and_privacy_review"
  },
