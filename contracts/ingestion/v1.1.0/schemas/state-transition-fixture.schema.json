{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/ingestion/v1.1.0/state-transition-fixture.schema.json",
  "title": "Complete state-machine transition fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_version", "machines"],
  "properties": {
    "fixture_version": { "const": "ingestion-state-transitions.v1.1.0" },
    "machines": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["machine", "states", "cases"],
        "properties": {
          "machine": { "enum": ["run", "job", "outbox", "source"] },
          "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "cases": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["from", "to", "expected", "context"],
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "expected": { "enum": ["allowed", "rejected"] },
                "context": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] } }
              }
            }
          }
        }
      }
    }
  }
}
