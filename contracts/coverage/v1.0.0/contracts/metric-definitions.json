{
  "contract_version": "1.0.0",
  "digest_taxonomy_ref": "contracts/digest-taxonomy.json",
  "definitions": [
    {
      "metric_id": "coverage.configured_scope_status/v1",
      "metric_version": "1.0.0",
      "label": "Configured scope status",
      "allowed_units": ["connector_scope"],
      "kind": "partition",
      "measured_stage": "registry",
      "numerator_definition": "Connector scopes whose one effective registry state equals the selected partition state at as_of.",
      "numerator_definition_version": "coverage.configured-scope.numerator/v1",
      "denominator_definition": "Every configured connector scope under the exact same registry revision, each appearing once.",
      "denominator_definition_version": "coverage.configured-scope.denominator/v1",
      "allowed_denominator_status": ["known"],
      "allow_estimated_rate": false,
      "required_revision_pins": ["registry_revision", "source_scope_revision", "policy_revision", "coverage_contract_version"],
      "filters_known_by_stage": ["connector", "connector_version", "source_platform", "authority_level", "jurisdiction", "cadence", "source_scope"],
      "partition": {
        "states": ["active", "paused", "excluded", "retired", "unassessed"],
        "equation": "active + paused + excluded + retired + unassessed = configured",
        "numerator_states": ["active", "paused", "excluded", "retired", "unassessed"]
      },
      "exclusions_remain_in_upstream_denominator": true,
      "absence_sensitive": false,
      "overlap_policy": "disjoint_required"
    },
    {
      "metric_id": "coverage.harvest_completion/v1",
      "metric_version": "1.0.0",
      "label": "Harvest completion",
      "allowed_units": ["connector_scope"],
      "kind": "conditional_rate",
      "measured_stage": "enumeration",
      "numerator_definition": "Active non-excluded due scopes with a complete persisted enumeration sealed in the reporting window.",
      "numerator_definition_version": "coverage.harvest-completion.numerator/v1",
      "denominator_definition": "Every active non-excluded connector scope due under the pinned cadence policy in the reporting window, including failed or incomplete attempts.",
      "denominator_definition_version": "coverage.harvest-completion.denominator/v1",
      "allowed_denominator_status": ["known"],
      "allow_estimated_rate": false,
      "required_revision_pins": ["registry_revision", "source_scope_revision", "policy_revision", "connector_revision", "connector_configuration_revision", "coverage_contract_version"],
      "filters_known_by_stage": ["connector", "connector_version", "source_platform", "authority_level", "jurisdiction", "cadence", "stage", "failure_state", "exclusion_state", "source_scope"],
      "partition": null,
      "exclusions_remain_in_upstream_denominator": false,
      "absence_sensitive": true,
      "overlap_policy": "disjoint_required"
    },
    {
      "metric_id": "coverage.discovered_inventory/v1",
      "metric_version": "1.0.0",
      "label": "Discovered inventory",
      "allowed_units": ["native_item"],
      "kind": "absolute_or_authoritative_total",
      "measured_stage": "enumeration",
      "numerator_definition": "Distinct source-scope and native-identifier pairs observed in the explicitly bounded run cohort.",
      "numerator_definition_version": "coverage.discovered-inventory.numerator/v1",
      "denominator_definition": "No denominator for an absolute count; an authoritative complete source total is admissible only after a sealed complete enumeration.",
      "denominator_definition_version": "coverage.discovered-inventory.denominator/v1",
      "allowed_denominator_status": ["known", "estimated", "unknown"],
      "allow_estimated_rate": false,
      "required_revision_pins": ["registry_revision", "source_scope_revision", "policy_revision", "connector_revision", "connector_configuration_revision", "coverage_contract_version"],
      "filters_known_by_stage": ["connector", "connector_version", "source_platform", "authority_level", "jurisdiction", "first_seen_band", "last_seen_band", "source_scope"],
      "partition": null,
      "exclusions_remain_in_upstream_denominator": true,
      "absence_sensitive": true,
      "overlap_policy": "non_additive_disclosure"
    },
    {
      "metric_id": "coverage.revision_ingestion/v1",
      "metric_version": "1.0.0",
      "label": "Revision ingestion",
      "allowed_units": ["native_item_revision"],
      "kind": "rate",
      "measured_stage": "capture",
      "numerator_definition": "Raw native-item revision observations durably captured with content and evidence identity.",
      "numerator_definition_version": "coverage.revision-ingestion.numerator/v1",
      "denominator_definition": "Every native-item revision observation emitted by the exact same bounded run cohort.",
      "denominator_definition_version": "coverage.revision-ingestion.denominator/v1",
      "allowed_denominator_status": ["known"],
      "allow_estimated_rate": false,
      "required_revision_pins": ["registry_revision", "source_scope_revision", "policy_revision", "connector_revision", "connector_configuration_revision", "coverage_contract_version"],
      "filters_known_by_stage": ["connector", "connector_version", "source_platform", "authority_level", "jurisdiction", "stage", "failure_state", "source_scope"],
      "partition": null,
      "exclusions_remain_in_upstream_denominator": true,
      "absence_sensitive": false,
      "overlap_policy": "disjoint_required"
    },
    {
      "metric_id": "coverage.normalized_outcome/v1",
      "metric_version": "1.0.0",
      "label": "Normalized outcome",
      "allowed_units": ["native_item_revision"],
      "kind": "partition",
      "measured_stage": "normalization",
      "numerator_definition": "Ingested native-item revisions mapped to canonical identifiers, including confirmed duplicates.",
      "numerator_definition_version": "coverage.normalized-outcome.numerator/v1",
      "denominator_definition": "Every ingested native-item revision in the exact same bounded run cohort, each appearing once in the six-state outcome partition.",
      "denominator_definition_version": "coverage.normalized-outcome.denominator/v1",
      "allowed_denominator_status": ["known"],
      "allow_estimated_rate": false,
      "required_revision_pins": ["registry_revision", "source_scope_revision", "policy_revision", "connector_revision", "connector_configuration_revision", "canonical_revision", "coverage_contract_version"],
      "filters_known_by_stage": ["connector", "connector_version", "source_platform", "authority_level", "jurisdiction", "subject", "asset_type", "access_class", "stage", "failure_state", "exclusion_state", "source_scope"],
      "partition": {
        "states": ["normalized", "pending", "failed", "excluded", "not_applicable", "unknown"],
        "equation": "normalized + pending + failed + excluded + not_applicable + unknown = ingested",
        "numerator_states": ["normalized"]
      },
      "exclusions_remain_in_upstream_denominator": true,
      "absence_sensitive": false,
      "overlap_policy": "disjoint_required"
    },
