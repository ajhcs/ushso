      "numerator_definition_version": "coverage.canonical-assets.numerator/v1",
      "denominator_definition": "No denominator exists because this metric is an absolute canonical asset inventory count.",
      "denominator_definition_version": null,
      "allowed_denominator_status": ["unknown"],
      "allow_estimated_rate": false,
      "required_revision_pins": ["policy_revision", "canonical_revision", "coverage_contract_version"],
      "filters_known_by_stage": ["authority_level", "jurisdiction", "subject", "asset_type", "access_class", "identity_state", "first_seen_band", "last_seen_band"],
