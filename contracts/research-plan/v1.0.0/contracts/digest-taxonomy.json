{
  "contract_version": "observatory-research-plan-digest-taxonomy.v1.0.0",
  "canonicalization_algorithm": "ushso-canonical-json.v1.0.0",
  "string_order": "utf8-bytewise",
  "number_policy": "safe-integer-only-no-negative-zero",
  "digests": [
    {
      "digest_kind": "canonical_plan",
      "algorithm": "sha256",
      "prefix": "sha256:",
      "coverage": "canonical_json",
      "excluded_json_pointers": ["/plan_id"],
      "transport_fields_outside_payload": ["/request_id", "/response_generated_at", "/clarification_token"]
    },
    {
      "digest_kind": "normalized_request",
      "algorithm": "sha256",
      "prefix": "sha256:",
      "coverage": "canonical_json",
      "excluded_json_pointers": ["/normalized_request_hash"],
      "transport_fields_outside_payload": []
    },
    {
      "digest_kind": "clarification_question_set",
      "algorithm": "sha256",
      "prefix": "sha256:",
      "coverage": "canonical_json",
      "excluded_json_pointers": [],
      "transport_fields_outside_payload": []
    },
    {
      "digest_kind": "package_file",
      "algorithm": "sha256",
      "prefix": "sha256:",
      "coverage": "raw_file_bytes",
      "excluded_json_pointers": [],
      "transport_fields_outside_payload": []
    },
    {
      "digest_kind": "package_manifest",
      "algorithm": "sha256",
      "prefix": "sha256:",
      "coverage": "canonical_json",
      "excluded_json_pointers": ["/manifest_digest"],
      "transport_fields_outside_payload": []
    }
  ]
}
