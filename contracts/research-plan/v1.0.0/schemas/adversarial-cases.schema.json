{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/research-plan/v1.0.0/schemas/adversarial-cases.schema.json",
  "title": "Research-plan adversarial mutation cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "cases"],
  "properties": {
    "contract_version": {"const": "observatory-research-plan-adversarial-cases.v1.0.0"},
    "cases": {
      "type": "array",
      "minItems": 15,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "base_plan_status", "mutation", "expected_codes"],
        "properties": {
          "case_id": {"$ref": "common.schema.json#/$defs/stableId"},
          "base_plan_status": {"enum": ["unsupported", "clarification_required", "incomplete", "ready_with_constraints", "ready"]},
          "mutation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "json_pointer", "value"],
            "properties": {
              "operation": {"enum": ["set", "delete", "push"]},
              "json_pointer": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^/"},
              "value": {}
            }
          },
          "expected_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/stableId"}
          }
        }
      }
    }
  }
}
