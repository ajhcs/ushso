{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/research-plan/v1.0.0/schemas/clarification-token-cases.schema.json",
  "title": "Clarification token scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "keys", "base_claims", "verification_context", "cases"],
  "properties": {
    "contract_version": {"const": "observatory-clarification-token-cases.v1.0.0"},
    "keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_version", "state", "test_secret"],
        "properties": {
          "key_version": {"type": "string", "minLength": 3, "maxLength": 64},
          "state": {"enum": ["active", "verify_only", "retired"]},
          "test_secret": {"type": "string", "minLength": 32, "maxLength": 128, "pattern": "^TEST_ONLY_"}
        }
      }
    },
    "base_claims": {"$ref": "clarification.schema.json#/$defs/tokenClaims"},
    "verification_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["now", "request_hash", "question_set_hash", "expected_generation"],
      "properties": {
        "now": {"$ref": "common.schema.json#/$defs/dateTime"},
        "request_hash": {"$ref": "common.schema.json#/$defs/digest"},
        "question_set_hash": {"$ref": "common.schema.json#/$defs/digest"},
        "expected_generation": {"$ref": "common.schema.json#/$defs/stableId"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "scenario", "expected_code"],
        "properties": {
          "case_id": {"$ref": "common.schema.json#/$defs/stableId"},
          "scenario": {"enum": ["valid", "tampered", "expired", "verify_only_rotation", "stale_generation", "changed_request_hash", "changed_question_set"]},
          "expected_code": {"$ref": "common.schema.json#/$defs/stableId"}
        }
      }
    }
  }
}
