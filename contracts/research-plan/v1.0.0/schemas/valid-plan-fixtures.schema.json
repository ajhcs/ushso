{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/research-plan/v1.0.0/schemas/valid-plan-fixtures.schema.json",
  "title": "Valid research-plan fixture bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plans"],
  "properties": {
    "contract_version": {"const": "observatory-research-plan-fixtures.v1.0.0"},
    "plans": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": {"$ref": "research-plan.schema.json"}
    }
  }
}
