{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/research-plan/v1.0.0/schemas/claim-manifest.schema.json",
  "title": "Versioned research-plan JSON-Pointer claim manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "claim_manifest_id", "schema_id", "truth_bearing_schema_files", "schema_property_inventory_digest", "auditable_roots", "critical_claims", "required_evidence_fields", "transport_only_pointers"],
  "properties": {
    "contract_version": {"const": "observatory-research-plan-claim-manifest.v1.0.0"},
    "claim_manifest_id": {"const": "obs:claim-manifest:research-plan:v1.0.0"},
    "schema_id": {"const": "https://ushso.org/contracts/research-plan/v1.0.0/schemas/research-plan.schema.json"},
    "truth_bearing_schema_files": {
      "type": "array",
      "minItems": 8,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10, "maxLength": 128, "pattern": "^schemas/[A-Za-z0-9.-]+\\.schema\\.json$"}
    },
    "schema_property_inventory_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "auditable_roots": {
      "type": "array",
      "minItems": 9,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 256, "pattern": "^/"}
    },
    "critical_claims": {
      "type": "array",
      "minItems": 11,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "json_pointer"],
        "properties": {
          "claim_id": {"$ref": "common.schema.json#/$defs/stableId"},
          "json_pointer": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/"}
        }
      }
    },
    "required_evidence_fields": {
      "type": "array",
      "minItems": 9,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/stableId"}
    },
    "transport_only_pointers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^/"}
    }
  }
}
