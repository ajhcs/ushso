{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackyard.local/observatory/core-contract/v1.0.0/access-observation.schema.json",
  "title": "AccessObservation",
  "description": "A time-bound observation that separates catalog visibility, data access, requirements, and infrastructure state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "entity_type", "observation_id", "subject_id", "access_status", "mechanisms", "requirements", "catalog_visibility_state", "data_access_state", "infrastructure_state", "origin", "evidence_ids", "confidence", "verifier", "observed_at", "status", "supersession", "offline_fixture"],
  "properties": {
    "contract_version": {"const": "observatory-core-contract.v1.0.0"},
    "entity_type": {"const": "AccessObservation"},
    "observation_id": {"$ref": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json#/$defs/id"},
    "subject_id": {"$ref": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json#/$defs/id"},
    "access_status": {"enum": ["public_direct", "public_metadata_only", "registration_required", "application_required", "dua_required", "licensed_paid", "controlled", "temporarily_unavailable", "unavailable", "unknown"]},
    "mechanisms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["web_download", "api", "bulk_download", "portal", "request_form", "license_workflow", "secure_enclave", "contact_owner", "unknown"]}},
    "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["none", "account", "registration", "application", "data_use_agreement", "license_agreement", "institutional_affiliation", "payment", "human_approval", "unknown"]}},
    "catalog_visibility_state": {"enum": ["visible", "partially_visible", "not_visible", "unavailable", "unknown"]},
    "data_access_state": {"enum": ["accessible", "metadata_only", "requires_action", "restricted", "unavailable", "not_tested", "unknown"]},
    "infrastructure_state": {"enum": ["available", "degraded", "blocked", "unreachable", "not_tested_offline", "unknown"]},
    "origin": {"$ref": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json#/$defs/origin"},
    "evidence_ids": {"$ref": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json#/$defs/evidenceIds"},
    "confidence": {"$ref": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json#/$defs/confidence"},
    "verifier": {"$ref": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json#/$defs/verifier"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"$ref": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json#/$defs/recordStatus"},
    "supersession": {"$ref": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json#/$defs/supersession"},
    "offline_fixture": {"const": true}
  }
}
