{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackyard.local/observatory/core-contract/v1.0.0/common.schema.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^obs:[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._:-]{1,190}$"},
    "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "recordStatus": {"enum": ["active", "superseded", "disputed", "retracted", "unresolved"]},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "origin_object_id", "locator", "method"],
      "properties": {
        "kind": {"enum": ["source_native", "captured_metadata", "deterministic_rule", "human", "agent", "imported_fixture"]},
        "origin_object_id": {"type": ["string", "null"], "pattern": "^obs:"},
        "locator": {"type": ["string", "null"], "format": "uri-reference"},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band", "rationale"],
      "properties": {
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "band": {"enum": ["high", "medium", "low", "unknown", "not_applicable"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verifier_id", "method", "result"],
      "properties": {
        "kind": {"enum": ["none", "source", "human", "agent", "deterministic_rule"]},
        "verifier_id": {"type": ["string", "null"]},
        "method": {"type": "string", "minLength": 1},
        "result": {"enum": ["verified", "partially_verified", "not_verified", "disputed", "not_applicable"]}
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes_ids", "superseded_by_id", "rationale"],
      "properties": {
        "supersedes_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "superseded_by_id": {"type": ["string", "null"], "pattern": "^obs:"},
        "rationale": {"type": ["string", "null"]}
      }
    },
    "sourceNativeIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value", "source_object_id", "preservation", "case_sensitive", "evidence_ids"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "source_object_id": {"$ref": "#/$defs/id"},
        "preservation": {"const": "exact"},
        "case_sensitive": {"type": "boolean"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    }
  }
}
