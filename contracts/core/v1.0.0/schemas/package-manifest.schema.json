{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackyard.local/observatory/core-contract/v1.0.0/package-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "package_version", "offline", "excludes", "file_count", "payload_bytes", "files", "immutable"],
  "properties": {
    "manifest_version": {"const": "observatory-core-package-manifest.v1"},
    "package_version": {"const": "1.0.0"},
    "offline": {"const": true},
    "excludes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "file_count": {"type": "integer", "minimum": 1},
    "payload_bytes": {"type": "integer", "minimum": 1},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "immutable": {"const": true}
  }
}
