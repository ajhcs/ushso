{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/core/v2.0.0/schemas/schema-snapshot.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/truthEnvelope" },
    {
      "type": "object",
      "required": ["schema_snapshot_id", "release_id", "distribution_id", "schema_digest", "field_ids", "immutable"],
      "properties": {
        "entity_type": { "const": "SchemaSnapshot" },
        "schema_snapshot_id": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/opaqueId" },
        "release_id": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/opaqueId" },
        "distribution_id": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/opaqueId" },
        "schema_digest": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/sha256" },
        "field_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/opaqueId" }
        },
        "immutable": { "const": true },
        "native_identifiers": { "type": "array", "minItems": 1 },
        "evidence_refs": { "type": "array", "minItems": 1 }
      }
    }
  ],
  "unevaluatedProperties": false
}
