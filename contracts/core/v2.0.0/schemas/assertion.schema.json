{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/core/v2.0.0/schemas/assertion.schema.json",
  "type": "object",
  "$defs": {
    "claimValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "string" },
            "value": { "type": "string", "minLength": 1, "maxLength": 5000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "boolean" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "date" },
            "value": { "type": "string", "format": "date" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "string_list" },
            "value": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "unknown" },
            "value": { "type": "null" }
          }
        }
      ]
    }
  },
  "allOf": [
    { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/truthEnvelope" },
    {
      "type": "object",
      "required": ["assertion_id", "subject_id", "predicate", "claim_value", "claim_class", "epistemic_state", "effective_from", "effective_to"],
      "properties": {
        "entity_type": { "const": "Assertion" },
        "assertion_id": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/opaqueId" },
        "subject_id": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/opaqueId" },
        "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,119}$" },
        "claim_value": { "$ref": "#/$defs/claimValue" },
        "claim_class": { "enum": ["identity", "description", "coverage", "publisher_time", "access", "schema", "fitness", "provenance", "other"] },
        "epistemic_state": { "enum": ["unknown", "candidate", "ambiguous", "documented", "observed", "proven", "disputed"] },
        "effective_from": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/nullableDateTime" },
        "effective_to": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/common.schema.json#/$defs/nullableDateTime" },
        "native_identifiers": { "type": "array", "maxItems": 0 },
        "evidence_refs": { "type": "array", "minItems": 1 },
        "assertion_refs": { "type": "array", "maxItems": 0 }
      }
    }
  ],
  "unevaluatedProperties": false
}
