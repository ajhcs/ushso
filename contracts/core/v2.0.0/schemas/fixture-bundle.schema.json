{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/core/v2.0.0/schemas/fixture-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "organizations", "sources", "assets", "releases", "distributions", "documentation", "schema_snapshots", "schema_fields", "access_routes", "access_observations", "evidence", "assertions", "relationships"],
  "properties": {
    "bundle_version": { "const": "observatory-core-fixture-bundle.v2.0.0" },
    "organizations": { "type": "array", "minItems": 1, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/organization.schema.json" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/source.schema.json" } },
    "assets": { "type": "array", "minItems": 2, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/asset.schema.json" } },
    "releases": { "type": "array", "minItems": 2, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/release.schema.json" } },
    "distributions": { "type": "array", "minItems": 2, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/distribution.schema.json" } },
    "documentation": { "type": "array", "minItems": 1, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/documentation.schema.json" } },
    "schema_snapshots": { "type": "array", "minItems": 2, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/schema-snapshot.schema.json" } },
    "schema_fields": { "type": "array", "minItems": 2, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/schema-field.schema.json" } },
    "access_routes": { "type": "array", "minItems": 2, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/access-route.schema.json" } },
    "access_observations": { "type": "array", "minItems": 2, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/access-observation.schema.json" } },
    "evidence": { "type": "array", "minItems": 5, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/evidence.schema.json" } },
    "assertions": { "type": "array", "minItems": 2, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/assertion.schema.json" } },
    "relationships": { "type": "array", "minItems": 3, "items": { "$ref": "https://ushso.org/contracts/core/v2.0.0/schemas/relationship.schema.json" } }
  }
}
