{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/identity/v1.0.0/package-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_name",
    "package_version",
    "mode",
    "offline",
    "manifest_excludes",
    "canonicalization",
    "digest_taxonomy",
    "file_count",
    "payload_bytes",
    "package_payload_digest_sha256",
    "files",
    "immutable"
  ],
  "properties": {
    "manifest_version": {"const": "identity.package-manifest.v1"},
    "package_name": {"const": "ushso/identity-contract"},
    "package_version": {"const": "1.0.0"},
    "mode": {"const": "fixture_offline"},
    "offline": {"const": true},
    "manifest_excludes": {"const": ["manifests/package-manifest.json", "validation/validation-receipt.json"]},
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm_id", "object_keys", "array_order", "encoding", "terminal_newline"],
      "properties": {
        "algorithm_id": {"const": "ushso.canonical-json.sorted-keys.v1"},
        "object_keys": {"const": "unicode-code-point-ascending"},
        "array_order": {"const": "preserved"},
        "encoding": {"const": "utf-8"},
        "terminal_newline": {"const": false}
      }
    },
    "digest_taxonomy": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest_id", "algorithm", "applies_to"],
          "properties": {
            "digest_id": {"const": "byte_sha256"},
            "algorithm": {"const": "sha256"},
            "applies_to": {"const": "exact stored bytes"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest_id", "algorithm", "applies_to"],
          "properties": {
            "digest_id": {"const": "canonical_json_sha256"},
            "algorithm": {"const": "sha256"},
            "applies_to": {"const": "parsed JSON under ushso.canonical-json.sorted-keys.v1"}
          }
        }
      ],
      "items": false
    },
    "file_count": {"type": "integer", "minimum": 1},
    "payload_bytes": {"type": "integer", "minimum": 1},
    "package_payload_digest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifact_kind", "media_type", "bytes", "byte_sha256", "canonical_json_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "artifact_kind": {"enum": ["schema", "fixture", "test", "tool", "documentation", "package_metadata"]},
          "media_type": {"enum": ["application/json", "text/javascript", "text/markdown"]},
          "bytes": {"type": "integer", "minimum": 0},
          "byte_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "canonical_json_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]}
        }
      }
    },
    "immutable": {"const": true}
  }
}
