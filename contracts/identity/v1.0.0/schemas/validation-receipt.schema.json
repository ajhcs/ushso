{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/identity/v1.0.0/validation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "package_version",
    "mode",
    "offline",
    "valid",
    "schema_count",
    "fixture_record_count",
    "positive_check_count",
    "adversarial_check_count",
    "adversarial_pass_count",
    "failed_count",
    "state_coverage",
    "manifest_verified",
    "manifest_byte_sha256",
    "package_payload_digest_sha256",
    "validation_input_digest_sha256",
    "external_requests",
    "source_payload_downloads",
    "identity_merges_performed",
    "analysis_executed",
    "production_auto_resolution_authorized",
    "checks",
    "errors",
    "immutable"
  ],
  "properties": {
    "receipt_version": {"const": "identity.validation-receipt.v1"},
    "package_version": {"const": "1.0.0"},
    "mode": {"const": "fixture_offline"},
    "offline": {"const": true},
    "valid": {"type": "boolean"},
    "schema_count": {"type": "integer", "minimum": 1},
    "fixture_record_count": {"type": "integer", "minimum": 1},
    "positive_check_count": {"type": "integer", "minimum": 1},
    "adversarial_check_count": {"type": "integer", "minimum": 1},
    "adversarial_pass_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "state_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_states", "decision_kinds", "family_kinds", "operation_kinds", "evidence_states", "compatibilities", "requirement_states"],
      "properties": {
        "candidate_states": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
        "decision_kinds": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
        "family_kinds": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
        "operation_kinds": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "evidence_states": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
        "compatibilities": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "requirement_states": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "manifest_verified": {"type": "boolean"},
    "manifest_byte_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "package_payload_digest_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "validation_input_digest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "external_requests": {"const": 0},
    "source_payload_downloads": {"const": 0},
    "identity_merges_performed": {"const": false},
    "analysis_executed": {"const": false},
    "production_auto_resolution_authorized": {"const": false},
    "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "immutable": {"const": true}
  }
}
