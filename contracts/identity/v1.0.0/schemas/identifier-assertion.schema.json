{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/identity/v1.0.0/identifier-assertion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assertion_id",
    "object_id",
    "namespace_id",
    "source_id",
    "raw_value",
    "normalized_value",
    "check_passed",
    "authority_class",
    "entity_type",
    "grain",
    "effective_interval",
    "evidence_ids",
    "state",
    "supersedes_assertion_id",
    "superseded_by_assertion_id",
    "observed_at",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "identity.identifier-assertion.v1.0.0"},
    "assertion_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
    "object_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
    "namespace_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
    "source_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
    "raw_value": {"type": "string", "minLength": 1, "maxLength": 500},
    "normalized_value": {"type": "string", "minLength": 1, "maxLength": 500},
    "check_passed": {"type": "boolean"},
    "authority_class": {"enum": ["authoritative", "source_native", "reported", "inferred"]},
    "entity_type": {"$ref": "common.schema.json#/$defs/entityType"},
    "grain": {"$ref": "common.schema.json#/$defs/grain"},
    "effective_interval": {"$ref": "common.schema.json#/$defs/effectiveInterval"},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/opaqueId"}
    },
    "state": {"enum": ["active", "superseded", "withdrawn"]},
    "supersedes_assertion_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/opaqueId"}, {"type": "null"}]},
    "superseded_by_assertion_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/opaqueId"}, {"type": "null"}]},
    "observed_at": {"$ref": "common.schema.json#/$defs/dateTime"},
    "recorded_at": {"$ref": "common.schema.json#/$defs/dateTime"}
  }
}
