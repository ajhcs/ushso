{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/dependency-pin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "dependency_package", "dependency_version", "schema_id", "schema_path", "schema_file_sha256", "compatibility"],
  "properties": {
    "contract_version": { "const": "observatory-machine-toolkit-dependency-pin.v1.0.0" },
    "dependency_package": { "const": "@ushso/research-plan-contract" },
    "dependency_version": { "const": "1.0.0" },
    "schema_id": { "const": "https://ushso.org/contracts/research-plan/v1.0.0/schemas/research-plan.schema.json" },
    "schema_path": { "const": "contracts/research-plan/v1.0.0/schemas/research-plan.schema.json" },
    "schema_file_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "compatibility": { "const": "exact_external_schema_reference_no_local_redefinition" }
  }
}
