{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/toolkit-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "toolkit_version", "manifest_id", "webmcp_specification", "registration_policy", "global_limits", "tools", "legacy_compatibility"],
  "properties": {
    "contract_version": { "const": "observatory-machine-toolkit.v1.0.0" },
    "toolkit_version": { "const": "1.0.0" },
    "manifest_id": { "$ref": "common.schema.json#/$defs/stableId" },
    "webmcp_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "snapshot_date", "repository", "commit", "pinned_specification_url", "browser_surface", "feature_detection_required"],
      "properties": {
        "status": { "const": "community_group_draft" },
        "snapshot_date": { "$ref": "common.schema.json#/$defs/date" },
        "repository": { "$ref": "common.schema.json#/$defs/uri" },
        "commit": { "type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[a-f0-9]{40}$" },
        "pinned_specification_url": { "$ref": "common.schema.json#/$defs/uri" },
        "browser_surface": { "const": "document.modelContext.registerTool" },
        "feature_detection_required": { "const": true }
      }
    },
    "registration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_origin_only", "enabled_tool_count", "default_tool_cap", "single_abort_signal", "clean_unregister_all", "browser_node_imports_allowed", "authoritative_source_egress_allowed", "source_acquisition_allowed"],
      "properties": {
        "same_origin_only": { "const": true },
        "enabled_tool_count": { "const": 0 },
        "default_tool_cap": { "const": 9 },
        "single_abort_signal": { "const": true },
        "clean_unregister_all": { "const": true },
        "browser_node_imports_allowed": { "const": false },
        "authoritative_source_egress_allowed": { "const": false },
        "source_acquisition_allowed": { "const": false }
      }
    },
    "global_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoded_input_bytes", "stable_id_characters", "url_characters", "research_text_characters", "clarification_answers", "clarification_answer_characters", "filter_dimensions", "filter_values_per_dimension", "filter_value_characters", "cursor_characters", "maintained_text_characters", "source_excerpt_characters", "warnings", "ordinary_evidence_references", "plan_evidence_references", "cursor_ttl_seconds", "clarification_ttl_seconds", "retired_generation_minimum_retention_seconds"],
      "properties": {
        "decoded_input_bytes": { "const": 20480 },
        "stable_id_characters": { "const": 128 },
        "url_characters": { "const": 2048 },
        "research_text_characters": { "const": 4000 },
        "clarification_answers": { "const": 20 },
        "clarification_answer_characters": { "const": 2000 },
        "filter_dimensions": { "const": 20 },
        "filter_values_per_dimension": { "const": 20 },
        "filter_value_characters": { "const": 128 },
        "cursor_characters": { "const": 2048 },
        "maintained_text_characters": { "const": 4000 },
        "source_excerpt_characters": { "const": 2000 },
        "warnings": { "const": 50 },
        "ordinary_evidence_references": { "const": 100 },
        "plan_evidence_references": { "const": 200 },
        "cursor_ttl_seconds": { "const": 1800 },
        "clarification_ttl_seconds": { "const": 86400 },
        "retired_generation_minimum_retention_seconds": { "const": 172800 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/tool" }
    },
    "legacy_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy_name", "preferred_name", "strategy", "registration_state", "default_registered", "input_schema_id", "output_schema_id", "legacy_audit_required", "limit_over_20_behavior", "semantic_translation"],
      "properties": {
        "legacy_name": { "const": "observatory.discover_sources" },
        "preferred_name": { "const": "observatory.search_assets" },
        "strategy": { "const": "versioned_gated_alias" },
        "registration_state": { "const": "disabled_pending_legacy_audit" },
        "default_registered": { "const": false },
        "input_schema_id": { "$ref": "common.schema.json#/$defs/uri" },
        "output_schema_id": { "$ref": "common.schema.json#/$defs/uri" },
        "legacy_audit_required": { "const": true },
        "limit_over_20_behavior": { "const": "fail_invalid_input_never_clip" },
        "semantic_translation": { "const": "question_to_search_mode_research_need" }
      }
    }
  },
  "$defs": {
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "default", "maximum", "unit"],
      "properties": {
        "json_pointer": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/" },
        "default": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 1000000 }, { "type": "null" }] },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "unit": { "enum": ["summaries", "nested_records", "steps_requirements", "parameters_hints", "fields", "allowed_values", "routes", "hops", "assets", "dimensions", "cohort_cells", "asset_contributions", "operations", "answers"] }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "tool_name", "title", "description", "input_schema_id", "response_schema_id", "canonical_service_method", "json_api", "human_ui_consumer", "authorization_class", "side_effect_class", "annotations", "required_gates", "registration_state", "input_max_bytes", "output_max_bytes", "cardinality_limits", "safety_atomic_sections"],
      "properties": {
        "capability": { "enum": ["search_assets", "get_asset", "get_access_plan", "get_retrieval_recipe", "get_variables", "get_join_routes", "compare_assets", "get_coverage_status", "plan_research"] },
        "tool_name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^observatory\\.[a-z_]+$" },
        "title": { "$ref": "common.schema.json#/$defs/shortText" },
        "description": { "$ref": "common.schema.json#/$defs/maintainedText" },
        "input_schema_id": { "$ref": "common.schema.json#/$defs/uri" },
        "response_schema_id": { "$ref": "common.schema.json#/$defs/uri" },
        "canonical_service_method": { "$ref": "common.schema.json#/$defs/stableId" },
        "json_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "route", "generation_parameter"],
          "properties": {
            "method": { "enum": ["GET", "POST"] },
            "route": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/api/" },
            "generation_parameter": { "enum": ["generation", "expected_generation"] }
          }
        },
        "human_ui_consumer": { "$ref": "common.schema.json#/$defs/nullableStableId" },
        "authorization_class": { "const": "public_read_only" },
        "side_effect_class": { "const": "none" },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readOnlyHint", "untrustedContentHint"],
          "properties": {
            "readOnlyHint": { "const": true },
            "untrustedContentHint": { "const": true }
          }
        },
        "required_gates": { "type": "array", "minItems": 3, "maxItems": 10, "uniqueItems": true, "items": { "enum": ["publication_runtime", "retrieval", "planner_safety", "planner_usefulness", "coverage", "identity_resolution", "machine_interface", "security_privacy", "core_contract_evidence", "access_contract_evidence", "retrieval_recipe_contract_evidence", "schema_contract_evidence", "comparison_contract_evidence"] } },
        "registration_state": { "enum": ["gated", "disabled_pending_gates"] },
        "input_max_bytes": { "const": 20480 },
        "output_max_bytes": { "enum": [65536, 98304, 131072, 262144] },
        "cardinality_limits": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/cardinality" } },
        "safety_atomic_sections": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/stableId" } }
      }
    }
  }
}
