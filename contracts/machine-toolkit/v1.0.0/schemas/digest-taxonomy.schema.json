{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/digest-taxonomy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "canonicalization", "digest_classes"],
  "properties": {
    "contract_version": { "const": "observatory-machine-toolkit-digests.v1.0.0" },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "array_order", "object_key_order"],
      "properties": {
        "algorithm": { "const": "rfc8785-jcs" },
        "encoding": { "const": "utf-8" },
        "array_order": { "const": "preserved" },
        "object_key_order": { "const": "utf-16-code-unit-ascending" }
      }
    },
    "digest_classes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "prefix", "covers", "excludes"],
        "properties": {
          "name": { "enum": ["file_sha256", "canonical_json_sha256", "result_snapshot_id", "candidate_snapshot_id"] },
          "prefix": { "enum": ["none", "sha256:"] },
          "covers": { "$ref": "common.schema.json#/$defs/maintainedText" },
          "excludes": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
        }
      }
    }
  }
}
