{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/compare-assets-input.schema.json",
  "title": "observatory.compare_assets input",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 4,
  "required": ["contract_version", "asset_ids", "dimensions", "expected_generation"],
  "properties": {
    "contract_version": { "const": "observatory.machine.compare-assets.input.v1.0.0" },
    "asset_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/stableId" }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "enum": ["role", "authority", "geography", "time", "grain", "access", "variables_schema", "freshness", "machine_readiness", "operation_kind", "join_evidence", "join_compatibility"] }
    },
    "expected_generation": { "$ref": "common.schema.json#/$defs/nullableStableId" }
  }
}
