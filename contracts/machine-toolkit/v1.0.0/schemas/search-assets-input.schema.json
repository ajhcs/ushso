{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/search-assets-input.schema.json",
  "title": "observatory.search_assets input",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 8,
      "required": ["contract_version", "mode", "filters", "sort", "grouping", "limit", "cursor", "expected_generation"],
      "properties": {
        "contract_version": { "const": "observatory.machine.search-assets.input.v1.0.0" },
        "mode": { "const": "browse" },
        "filters": { "$ref": "common.schema.json#/$defs/structuredFilters" },
        "sort": { "enum": ["title_asc", "publisher_title", "updated_desc"] },
        "grouping": { "enum": ["none", "family", "source", "release"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "cursor": { "$ref": "common.schema.json#/$defs/nullableCursor" },
        "expected_generation": { "$ref": "common.schema.json#/$defs/nullableStableId" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 8,
      "required": ["contract_version", "mode", "research_need", "filters", "grouping", "limit", "cursor", "expected_generation"],
      "properties": {
        "contract_version": { "const": "observatory.machine.search-assets.input.v1.0.0" },
        "mode": { "const": "search" },
        "research_need": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "filters": { "$ref": "common.schema.json#/$defs/structuredFilters" },
        "grouping": { "enum": ["none", "family", "source", "release"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "cursor": { "$ref": "common.schema.json#/$defs/nullableCursor" },
        "expected_generation": { "$ref": "common.schema.json#/$defs/nullableStableId" }
      }
    }
  ]
}
