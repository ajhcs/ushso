{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-coverage-status-input.schema.json",
  "title": "observatory.get_coverage_status input",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 9,
  "required": ["contract_version", "geography_ids", "subject_ids", "source_classes", "time_period", "authority_levels", "limit", "cursor", "expected_generation"],
  "properties": {
    "contract_version": { "const": "observatory.machine.get-coverage-status.input.v1.0.0" },
    "geography_ids": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/stableId" }
    },
    "subject_ids": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/stableId" }
    },
    "source_classes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/stableId" }
    },
    "time_period": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/timePeriod" },
        { "type": "null" }
      ]
    },
    "authority_levels": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "enum": ["authoritative", "official_mirror", "maintainer", "secondary", "candidate", "unknown"] }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cursor": { "$ref": "common.schema.json#/$defs/nullableCursor" },
    "expected_generation": { "$ref": "common.schema.json#/$defs/nullableStableId" }
  }
}
