{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/legacy-discover-sources-input.schema.json",
  "title": "Gated observatory.discover_sources compatibility input",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 8,
  "required": ["question"],
  "properties": {
    "question": { "type": "string", "minLength": 3, "maxLength": 500 },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "codes": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 20 } },
        "levels": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "enum": ["national", "multi_state", "state", "county", "facility", "mixed", "unknown"] } }
      }
    },
    "subjects": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "units_of_analysis": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "access_statuses": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "include_restricted": { "type": "boolean", "default": true },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "start_year": { "type": "integer", "minimum": 1800, "maximum": 2200 },
        "end_year": { "type": "integer", "minimum": 1800, "maximum": 2200 }
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 }
  }
}
