{
  "contract_version": "observatory-machine-toolkit.v1.0.0",
  "toolkit_version": "1.0.0",
  "manifest_id": "machine-toolkit.manifest.v1.0.0",
  "webmcp_specification": {
    "status": "community_group_draft",
    "snapshot_date": "2026-08-26",
    "repository": "https://github.com/webmachinelearning/webmcp",
    "commit": "41d12f057167ccf5954dbcf49d99502cb6c84491",
    "pinned_specification_url": "https://github.com/webmachinelearning/webmcp/blob/41d12f057167ccf5954dbcf49d99502cb6c84491/index.bs",
    "browser_surface": "document.modelContext.registerTool",
    "feature_detection_required": true
  },
  "registration_policy": {
    "same_origin_only": true,
    "enabled_tool_count": 0,
    "default_tool_cap": 9,
    "single_abort_signal": true,
    "clean_unregister_all": true,
    "browser_node_imports_allowed": false,
    "authoritative_source_egress_allowed": false,
    "source_acquisition_allowed": false
  },
  "global_limits": {
    "decoded_input_bytes": 20480,
    "stable_id_characters": 128,
    "url_characters": 2048,
    "research_text_characters": 4000,
    "clarification_answers": 20,
    "clarification_answer_characters": 2000,
    "filter_dimensions": 20,
    "filter_values_per_dimension": 20,
    "filter_value_characters": 128,
    "cursor_characters": 2048,
    "maintained_text_characters": 4000,
    "source_excerpt_characters": 2000,
    "warnings": 50,
    "ordinary_evidence_references": 100,
    "plan_evidence_references": 200,
    "cursor_ttl_seconds": 1800,
    "clarification_ttl_seconds": 86400,
    "retired_generation_minimum_retention_seconds": 172800
  },
  "tools": [
    {
      "capability": "search_assets",
      "tool_name": "observatory.search_assets",
      "title": "Search USHSO research assets",
      "description": "Browse indexed public-source asset metadata or identify bounded candidate assets for a stated research need. Returns summaries and evidence only; it does not retrieve source data or run analysis.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/search-assets-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/search-assets-response.schema.json",
      "canonical_service_method": "machine.searchAssets",
      "json_api": { "method": "POST", "route": "/api/discover", "generation_parameter": "expected_generation" },
      "human_ui_consumer": "catalog.search",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "machine_interface", "security_privacy", "retrieval"],
      "registration_state": "gated",
      "input_max_bytes": 20480,
      "output_max_bytes": 65536,
      "cardinality_limits": [
        { "json_pointer": "/limit", "default": 5, "maximum": 20, "unit": "summaries" }
      ],
      "safety_atomic_sections": ["truth_boundary", "warnings"]
    },
    {
      "capability": "get_asset",
      "tool_name": "observatory.get_asset",
      "title": "Get one USHSO asset",
      "description": "Dereference one stable canonical asset view from an immutable generation, including separately bounded releases, distributions, documentation, and schemas.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-asset-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-asset-response.schema.json",
      "canonical_service_method": "machine.getAsset",
      "json_api": { "method": "GET", "route": "/api/datasets/{record_id}", "generation_parameter": "generation" },
      "human_ui_consumer": "dataset.detail",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "machine_interface", "security_privacy", "core_contract_evidence"],
      "registration_state": "gated",
      "input_max_bytes": 20480,
      "output_max_bytes": 131072,
      "cardinality_limits": [
        { "json_pointer": "/collection_limits/releases", "default": 20, "maximum": 50, "unit": "nested_records" },
        { "json_pointer": "/collection_limits/distributions", "default": 20, "maximum": 50, "unit": "nested_records" },
        { "json_pointer": "/collection_limits/documentation", "default": 20, "maximum": 50, "unit": "nested_records" },
        { "json_pointer": "/collection_limits/schemas", "default": 20, "maximum": 50, "unit": "nested_records" }
      ],
      "safety_atomic_sections": ["asset", "source", "identity_state", "family_state", "truth_boundary", "warnings"]
    },
    {
      "capability": "get_access_plan",
      "tool_name": "observatory.get_access_plan",
      "title": "Explain an asset access plan",
      "description": "Explain source-documented eligibility criteria, requirements, human gates, and process without assessing the requester, authorizing access, or submitting anything.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-access-plan-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-access-plan-response.schema.json",
      "canonical_service_method": "machine.getAccessPlan",
      "json_api": { "method": "GET", "route": "/api/datasets/{record_id}/access-plan", "generation_parameter": "generation" },
      "human_ui_consumer": "dataset.accessPlan",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "machine_interface", "security_privacy", "access_contract_evidence"],
      "registration_state": "gated",
      "input_max_bytes": 20480,
      "output_max_bytes": 65536,
      "cardinality_limits": [
        { "json_pointer": "/result/requirements", "default": null, "maximum": 50, "unit": "steps_requirements" },
        { "json_pointer": "/result/process_steps", "default": null, "maximum": 50, "unit": "steps_requirements" }
      ],
      "safety_atomic_sections": ["access_plan", "human_authorization_gate", "requirements", "truth_boundary", "warnings"]
    },
    {
      "capability": "get_retrieval_recipe",
      "tool_name": "observatory.get_retrieval_recipe",
      "title": "Explain an asset retrieval recipe",
      "description": "Return bounded, redacted technical metadata for a documented retrieval interface. It may show sample requests, but never source response bodies, payload excerpts, or executed retrieval.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-retrieval-recipe-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-retrieval-recipe-response.schema.json",
      "canonical_service_method": "machine.getRetrievalRecipe",
      "json_api": { "method": "GET", "route": "/api/datasets/{record_id}/retrieval-recipe", "generation_parameter": "generation" },
      "human_ui_consumer": "dataset.retrievalRecipe",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "machine_interface", "security_privacy", "retrieval_recipe_contract_evidence"],
      "registration_state": "gated",
      "input_max_bytes": 20480,
      "output_max_bytes": 65536,
      "cardinality_limits": [
        { "json_pointer": "/result/parameters", "default": null, "maximum": 100, "unit": "parameters_hints" },
        { "json_pointer": "/result/parser_hints", "default": null, "maximum": 100, "unit": "parameters_hints" }
      ],
      "safety_atomic_sections": ["retrieval_recipe", "checks", "stop_conditions", "truth_boundary", "warnings"]
    },
    {
      "capability": "get_variables",
      "tool_name": "observatory.get_variables",
      "title": "Inspect indexed schema fields",
      "description": "Search or page through bounded field metadata for one exact asset, release, distribution, and schema context while preserving partial and unknown dictionary states.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-variables-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-variables-response.schema.json",
      "canonical_service_method": "machine.getVariables",
      "json_api": { "method": "GET", "route": "/api/datasets/{record_id}/variables", "generation_parameter": "generation" },
      "human_ui_consumer": "dataset.variables",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "machine_interface", "security_privacy", "schema_contract_evidence"],
      "registration_state": "gated",
      "input_max_bytes": 20480,
      "output_max_bytes": 131072,
      "cardinality_limits": [
        { "json_pointer": "/limit", "default": 25, "maximum": 100, "unit": "fields" },
        { "json_pointer": "/result/fields/*/allowed_values", "default": null, "maximum": 100, "unit": "allowed_values" }
      ],
      "safety_atomic_sections": ["schema_context", "field", "limitations", "truth_boundary", "warnings"]
    },
    {
      "capability": "get_join_routes",
      "tool_name": "observatory.get_join_routes",
      "title": "Inspect documented join routes",
      "description": "Return direct or explicitly requested two-hop metadata routes with separate operation, evidence, compatibility, requirements, blockers, and temporal applicability.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-join-routes-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-join-routes-response.schema.json",
      "canonical_service_method": "machine.getJoinRoutes",
      "json_api": { "method": "GET", "route": "/api/join-routes", "generation_parameter": "generation" },
      "human_ui_consumer": "dataset.joinRoutes",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "machine_interface", "security_privacy", "identity_resolution"],
      "registration_state": "gated",
      "input_max_bytes": 20480,
      "output_max_bytes": 131072,
      "cardinality_limits": [
        { "json_pointer": "/limit", "default": null, "maximum": 50, "unit": "routes" },
        { "json_pointer": "/max_hops", "default": 1, "maximum": 2, "unit": "hops" }
      ],
      "safety_atomic_sections": ["route", "requirements", "blockers", "caveats", "truth_boundary", "warnings"]
    },
    {
      "capability": "compare_assets",
      "tool_name": "observatory.compare_assets",
      "title": "Compare asset metadata",
      "description": "Compare two to five assets across bounded metadata dimensions, including unknown and incompatible states, without comparing source values or producing analytical rankings.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/compare-assets-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/compare-assets-response.schema.json",
      "canonical_service_method": "machine.compareAssets",
      "json_api": { "method": "POST", "route": "/api/compare-assets", "generation_parameter": "expected_generation" },
      "human_ui_consumer": "catalog.compare",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "machine_interface", "security_privacy", "comparison_contract_evidence"],
      "registration_state": "gated",
      "input_max_bytes": 20480,
      "output_max_bytes": 98304,
      "cardinality_limits": [
        { "json_pointer": "/asset_ids", "default": null, "maximum": 5, "unit": "assets" },
        { "json_pointer": "/dimensions", "default": null, "maximum": 12, "unit": "dimensions" }
      ],
      "safety_atomic_sections": ["comparison", "requirements", "blockers", "truth_boundary", "warnings"]
    },
    {
      "capability": "get_coverage_status",
      "tool_name": "observatory.get_coverage_status",
      "title": "Explain USHSO coverage status",
      "description": "Return bounded coverage cells, explicit denominators and unknown states, and whether evidence permits an absence claim for the selected public scope.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-coverage-status-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/get-coverage-status-response.schema.json",
      "canonical_service_method": "machine.getCoverageStatus",
      "json_api": { "method": "GET", "route": "/api/coverage/status", "generation_parameter": "generation" },
      "human_ui_consumer": "coverage.status",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "machine_interface", "security_privacy", "coverage"],
      "registration_state": "gated",
      "input_max_bytes": 20480,
      "output_max_bytes": 131072,
      "cardinality_limits": [
        { "json_pointer": "/limit", "default": null, "maximum": 100, "unit": "cohort_cells" }
      ],
      "safety_atomic_sections": ["denominator", "coverage_cell", "interpretation", "truth_boundary", "warnings"]
    },
    {
      "capability": "plan_research",
      "tool_name": "observatory.plan_research",
      "title": "Compile an evidence-bound research plan",
      "description": "Compile a deterministic plan from immutable public metadata and evidence. It recommends and explains source contributions but does not retrieve payloads, execute operations, or perform analysis.",
      "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/plan-research-input.schema.json",
      "response_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/plan-research-response.schema.json",
      "canonical_service_method": "machine.planResearch",
      "json_api": { "method": "POST", "route": "/api/plan", "generation_parameter": "expected_generation" },
      "human_ui_consumer": "planner.plan",
      "authorization_class": "public_read_only",
      "side_effect_class": "none",
      "annotations": { "readOnlyHint": true, "untrustedContentHint": true },
      "required_gates": ["publication_runtime", "retrieval", "planner_safety", "planner_usefulness", "coverage", "identity_resolution", "machine_interface", "security_privacy"],
      "registration_state": "disabled_pending_gates",
      "input_max_bytes": 20480,
      "output_max_bytes": 262144,
      "cardinality_limits": [
        { "json_pointer": "/result/plan/asset_contributions", "default": null, "maximum": 12, "unit": "asset_contributions" },
        { "json_pointer": "/result/plan/operations", "default": null, "maximum": 50, "unit": "operations" },
        { "json_pointer": "/clarification_answers", "default": null, "maximum": 20, "unit": "answers" }
      ],
      "safety_atomic_sections": ["research_plan", "access", "operations", "blockers", "truth_boundary", "warnings"]
    }
  ],
  "legacy_compatibility": {
    "legacy_name": "observatory.discover_sources",
    "preferred_name": "observatory.search_assets",
    "strategy": "versioned_gated_alias",
    "registration_state": "disabled_pending_legacy_audit",
    "default_registered": false,
    "input_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/legacy-discover-sources-input.schema.json",
    "output_schema_id": "https://ushso.org/contracts/machine-toolkit/v1.0.0/schemas/search-assets-response.schema.json",
    "legacy_audit_required": true,
    "limit_over_20_behavior": "fail_invalid_input_never_clip",
    "semantic_translation": "question_to_search_mode_research_need"
  }
}
