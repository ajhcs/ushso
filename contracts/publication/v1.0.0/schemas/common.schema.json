{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/common.schema.json",
  "title": "USHSO publication common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,191}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "digestDomain": {
      "type": "string",
      "enum": [
        "canonical_revision_membership",
        "projection_document",
        "projection_set",
        "component_generation",
        "full_snapshot_build",
        "publication_manifest",
        "legacy_static_compatibility",
        "package_manifest"
      ]
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "domain", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "ushso-canonical-json-v1"},
        "domain": {"$ref": "#/$defs/digestDomain"},
        "value": {"$ref": "#/$defs/sha256"}
      }
    },
    "componentKind": {
      "type": "string",
      "enum": [
        "asset_search",
        "release_distribution_search",
        "schema_field_search",
        "source_search",
        "join_edge_search",
        "seo",
        "coverage"
      ]
    },
    "canonicalObjectType": {
      "type": "string",
      "enum": [
        "organization",
        "source",
        "asset",
        "release",
        "distribution",
        "documentation",
        "schema_snapshot",
        "field",
        "access_route",
        "access_observation",
        "relationship"
      ]
    },
    "visibilityState": {
      "type": "string",
      "enum": ["public", "excluded", "quarantined", "tombstoned", "internal"]
    },
    "generationState": {
      "type": "string",
      "enum": ["building", "validated", "published", "retired", "rejected", "physically_expired"]
    },
    "canonicalManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "digest"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "componentGenerationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_kind", "generation_id", "manifest_digest"],
      "properties": {
        "component_kind": {"$ref": "#/$defs/componentKind"},
        "generation_id": {"$ref": "#/$defs/id"},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "publicationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_id", "manifest_digest"],
      "properties": {
        "publication_id": {"$ref": "#/$defs/id"},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
