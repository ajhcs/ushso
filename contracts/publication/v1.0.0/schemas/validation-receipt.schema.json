{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/validation-receipt.schema.json",
  "title": "Publication contract validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "package_version", "mode", "valid", "schema_count", "positive_check_count", "adversarial_check_count", "failed_count", "fixture_digest", "manifest_verified", "manifest_sha256", "external_requests", "database_writes", "publication_pointer_writes", "checks", "errors", "immutable"],
  "properties": {
    "receipt_version": {"const": "publication-contract-validation.v1"},
    "package_version": {"const": "1.0.0"},
    "mode": {"const": "fixture_offline"},
    "valid": {"type": "boolean"},
    "schema_count": {"type": "integer", "minimum": 1},
    "positive_check_count": {"type": "integer", "minimum": 1},
    "adversarial_check_count": {"type": "integer", "minimum": 1},
    "failed_count": {"type": "integer", "minimum": 0},
    "fixture_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_verified": {"type": "boolean"},
    "manifest_sha256": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]},
    "external_requests": {"const": 0},
    "database_writes": {"const": 0},
    "publication_pointer_writes": {"const": 0},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "errors": {"type": "array", "items": {"type": "string"}},
    "immutable": {"const": true}
  }
}
