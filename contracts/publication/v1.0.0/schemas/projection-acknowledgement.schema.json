{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/projection-acknowledgement.schema.json",
  "title": "Projection obligation acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["acknowledgement_version", "acknowledgement_id", "generation_id", "component_kind", "canonical_manifest_id", "canonical_id", "revision_id", "visibility_state", "result", "document_refs", "exclusion", "acknowledged_at", "immutable"],
  "properties": {
    "acknowledgement_version": {"const": "projection-acknowledgement.v1"},
    "acknowledgement_id": {"$ref": "common.schema.json#/$defs/id"},
    "generation_id": {"$ref": "common.schema.json#/$defs/id"},
    "component_kind": {"$ref": "common.schema.json#/$defs/componentKind"},
    "canonical_manifest_id": {"$ref": "common.schema.json#/$defs/id"},
    "canonical_id": {"$ref": "common.schema.json#/$defs/id"},
    "revision_id": {"$ref": "common.schema.json#/$defs/id"},
    "visibility_state": {"$ref": "common.schema.json#/$defs/visibilityState"},
    "result": {"type": "string", "enum": ["projected", "excluded"]},
    "document_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "document_checksum"],
        "properties": {
          "document_id": {"$ref": "common.schema.json#/$defs/id"},
          "document_checksum": {"$ref": "common.schema.json#/$defs/digest"}
        }
      }
    },
    "exclusion": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code", "evidence_refs", "absence_claim_permitted"],
          "properties": {
            "reason_code": {"type": "string", "enum": ["visibility_excluded", "quarantined", "tombstoned", "internal_only"]},
            "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
            "absence_claim_permitted": {"const": false}
          }
        }
      ]
    },
    "acknowledged_at": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "immutable": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "projected"}}},
      "then": {"properties": {"document_refs": {"type": "array", "minItems": 1}, "exclusion": {"type": "null"}}}
    },
    {
      "if": {"properties": {"result": {"const": "excluded"}}},
      "then": {"properties": {"document_refs": {"type": "array", "maxItems": 0}, "exclusion": {"type": "object"}}}
    }
  ]
}
