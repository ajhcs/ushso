{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/adversarial-cases.schema.json",
  "title": "Publication contract adversarial fixture cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_version", "base_fixture", "cases"],
  "properties": {
    "fixture_version": {"const": "publication-adversarial-cases.v1"},
    "base_fixture": {"const": "fixtures/valid-publication.json"},
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "description", "mutations", "expected_code"],
        "properties": {
          "case_id": {"$ref": "common.schema.json#/$defs/id"},
          "description": {"type": "string", "minLength": 8},
          "mutations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["op", "path", "value"],
                  "properties": {
                    "op": {"const": "set"},
                    "path": {"type": "string", "pattern": "^/"},
                    "value": true
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["op", "path"],
                  "properties": {
                    "op": {"const": "delete"},
                    "path": {"type": "string", "pattern": "^/"}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["op", "path", "left", "right"],
                  "properties": {
                    "op": {"const": "swap"},
                    "path": {"type": "string", "pattern": "^/"},
                    "left": {"type": "integer", "minimum": 0},
                    "right": {"type": "integer", "minimum": 0}
                  }
                }
              ]
            }
          },
          "expected_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      }
    }
  }
}
