{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/full-snapshot-build-receipt.schema.json",
  "title": "Complete as-of-W1 full snapshot build receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "receipt_id", "build_strategy", "candidate_outcome", "canonical_manifest_ref", "previous_publication_ref", "component_generation_refs", "barriers", "counts", "degraded_optional_stages", "repeatability", "deterministic_build_checksum", "started_at", "sealed_at", "immutable"],
  "properties": {
    "receipt_version": {"const": "full-snapshot-build-receipt.v1"},
    "receipt_id": {"$ref": "common.schema.json#/$defs/id"},
    "build_strategy": {"const": "complete_as_of_exact_revision_manifest"},
    "candidate_outcome": {"type": "string", "enum": ["validated", "rejected"]},
    "canonical_manifest_ref": {"$ref": "common.schema.json#/$defs/canonicalManifestRef"},
    "previous_publication_ref": {
      "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/publicationRef"}]
    },
    "component_generation_refs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "common.schema.json#/$defs/componentGenerationRef"}
    },
    "barriers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["barrier", "status", "evidence_refs"],
        "properties": {
          "barrier": {
            "type": "string",
            "enum": [
              "complete_sealed_enumeration",
              "membership_checkpoint_committed",
              "terminal_normalized_or_excluded",
              "w1_sealed",
              "all_projection_obligations_acknowledged",
              "references_resolved",
              "checksums_verified",
              "visibility_reconciled",
              "search_seo_coverage_reconciled"
            ]
          },
          "status": {"type": "string", "enum": ["passed", "failed"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_revisions", "projection_obligations", "acknowledgements", "projected", "excluded", "documents"],
      "properties": {
        "canonical_revisions": {"type": "integer", "minimum": 1},
        "projection_obligations": {"type": "integer", "minimum": 1},
        "acknowledgements": {"type": "integer", "minimum": 1},
        "projected": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "documents": {"type": "integer", "minimum": 0}
      }
    },
    "degraded_optional_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "policy_version", "affected_ids", "inherited_or_unknown_state"],
        "properties": {
          "stage": {"type": "string", "enum": ["non_required_schema_field_enrichment", "supplementary_documentation_enrichment", "scheduled_access_reprobe", "candidate_only_identity_family_scoring"]},
          "policy_version": {"$ref": "common.schema.json#/$defs/version"},
          "affected_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
          "inherited_or_unknown_state": {"type": "string", "enum": ["inherited_stale", "unknown"]}
        }
      }
    },
    "repeatability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_build_id", "second_build_id", "first_checksum", "second_checksum", "identical"],
      "properties": {
        "first_build_id": {"$ref": "common.schema.json#/$defs/id"},
        "second_build_id": {"$ref": "common.schema.json#/$defs/id"},
        "first_checksum": {"$ref": "common.schema.json#/$defs/sha256"},
        "second_checksum": {"$ref": "common.schema.json#/$defs/sha256"},
        "identical": {"const": true}
      }
    },
    "deterministic_build_checksum": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/digest"},
        {"type": "object", "properties": {"domain": {"const": "full_snapshot_build"}}}
      ]
    },
    "started_at": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "sealed_at": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "immutable": {"const": true}
  }
}
