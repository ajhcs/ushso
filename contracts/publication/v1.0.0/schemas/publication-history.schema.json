{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/publication-history.schema.json",
  "title": "Append-only publication pointer history",
  "type": "object",
  "additionalProperties": false,
  "required": ["history_version", "events", "append_only"],
  "properties": {
    "history_version": {"const": "publication-history.v1"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "sequence", "action", "from_publication_ref", "to_publication_ref", "occurred_at", "transaction_id", "atomic_commit", "actor_kind", "reason_code"],
        "properties": {
          "event_id": {"$ref": "common.schema.json#/$defs/id"},
          "sequence": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "enum": ["promote", "rollback"]},
          "from_publication_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/publicationRef"}]},
          "to_publication_ref": {"$ref": "common.schema.json#/$defs/publicationRef"},
          "occurred_at": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
          "transaction_id": {"$ref": "common.schema.json#/$defs/id"},
          "atomic_commit": {"const": true},
          "actor_kind": {"type": "string", "enum": ["projector", "operations"]},
          "reason_code": {"type": "string", "enum": ["all_gates_passed", "restore_previous_validated", "emergency_static_recovery"]}
        }
      }
    },
    "append_only": {"const": true}
  }
}
