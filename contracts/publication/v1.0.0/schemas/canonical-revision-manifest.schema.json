{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/canonical-revision-manifest.schema.json",
  "title": "Exact immutable canonical revision membership manifest (W1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "manifest_id", "selection_model", "canonical_as_of", "sealed_at", "member_order", "revision_count", "projection_obligation_count", "members", "membership_digest", "immutable"],
  "properties": {
    "manifest_version": {"const": "canonical-revision-membership.v1"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/id"},
    "selection_model": {"const": "exact_immutable_revision_membership"},
    "canonical_as_of": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "sealed_at": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "member_order": {"const": "canonical_id_then_revision_id_unicode_ascending"},
    "revision_count": {"type": "integer", "minimum": 1},
    "projection_obligation_count": {"type": "integer", "minimum": 1},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_type", "canonical_id", "revision_id", "revision_sha256", "visibility_state", "projection_obligations"],
        "properties": {
          "object_type": {"$ref": "common.schema.json#/$defs/canonicalObjectType"},
          "canonical_id": {"$ref": "common.schema.json#/$defs/id"},
          "revision_id": {"$ref": "common.schema.json#/$defs/id"},
          "revision_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "visibility_state": {"$ref": "common.schema.json#/$defs/visibilityState"},
          "projection_obligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/componentKind"}
          }
        }
      }
    },
    "membership_digest": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/digest"},
        {"type": "object", "properties": {"domain": {"const": "canonical_revision_membership"}}}
      ]
    },
    "immutable": {"const": true}
  }
}
