{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/projection-document.schema.json",
  "title": "Deterministic non-authoritative publication projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["projection_version", "document_id", "document_type", "projection_schema_version", "generation_id", "projected_at", "canonical_revisions", "projection_input_refs", "visibility_state", "truth_refs", "content", "document_checksum", "source_of_truth", "immutable"],
  "properties": {
    "projection_version": {"const": "projection-document.v1"},
    "document_id": {"$ref": "common.schema.json#/$defs/id"},
    "document_type": {"$ref": "common.schema.json#/$defs/componentKind"},
    "projection_schema_version": {"$ref": "common.schema.json#/$defs/version"},
    "generation_id": {"$ref": "common.schema.json#/$defs/id"},
    "projected_at": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "canonical_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "revision_id", "revision_sha256"],
        "properties": {
          "canonical_id": {"$ref": "common.schema.json#/$defs/id"},
          "revision_id": {"$ref": "common.schema.json#/$defs/id"},
          "revision_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    },
    "projection_input_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "visibility_state": {"const": "public"},
    "truth_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "assertions", "access_observations", "documentation", "relationships"],
      "properties": {
        "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "assertions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "access_observations": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "documentation": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "relationships": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true}
      }
    },
    "content": {"type": "object", "minProperties": 1},
    "document_checksum": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/digest"},
        {"type": "object", "properties": {"domain": {"const": "projection_document"}}}
      ]
    },
    "source_of_truth": {"const": false},
    "immutable": {"const": true}
  }
}
