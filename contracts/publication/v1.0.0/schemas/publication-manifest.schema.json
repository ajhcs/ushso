{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/publication/v1.0.0/publication-manifest.schema.json",
  "title": "Immutable coherent publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "publication_id", "contract_version", "candidate_state", "canonical_manifest_ref", "canonical_as_of", "component_generation_refs", "coverage_snapshot_id", "build_receipt_ref", "build_receipt_digest", "visibility_policy", "promotion", "rollback", "retention", "publication_digest", "sealed_at", "immutable"],
  "properties": {
    "manifest_version": {"const": "publication-manifest.v1"},
    "publication_id": {"$ref": "common.schema.json#/$defs/id"},
    "contract_version": {"const": "1.0.0"},
    "candidate_state": {"const": "validated"},
    "canonical_manifest_ref": {"$ref": "common.schema.json#/$defs/canonicalManifestRef"},
    "canonical_as_of": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "component_generation_refs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "common.schema.json#/$defs/componentGenerationRef"}
    },
    "coverage_snapshot_id": {"$ref": "common.schema.json#/$defs/id"},
    "build_receipt_ref": {"$ref": "common.schema.json#/$defs/id"},
    "build_receipt_digest": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/digest"},
        {"type": "object", "properties": {"domain": {"const": "full_snapshot_build"}}}
      ]
    },
    "visibility_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "public_states", "excluded_states", "absence_claim_permitted_for_exclusions"],
      "properties": {
        "policy_version": {"$ref": "common.schema.json#/$defs/version"},
        "public_states": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"const": "public"}], "items": false},
        "excluded_states": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["excluded", "quarantined", "tombstoned", "internal"]}
        },
        "absence_claim_permitted_for_exclusions": {"const": false}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "atomic_pointer_switch_required", "partial_promotion_allowed", "required_barrier_status"],
      "properties": {
        "eligible": {"const": true},
        "atomic_pointer_switch_required": {"const": true},
        "partial_promotion_allowed": {"const": false},
        "required_barrier_status": {"const": "all_passed"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_publication_ref", "n_minus_one_worker", "static_compatibility_ref"],
      "properties": {
        "previous_publication_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/publicationRef"}]},
        "n_minus_one_worker": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["worker_version", "artifact_sha256", "supported_publication_contract"],
              "properties": {
                "worker_version": {"$ref": "common.schema.json#/$defs/version"},
                "artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
                "supported_publication_contract": {"const": "1.0.0"}
              }
            }
          ]
        },
        "static_compatibility_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_id", "manifest_digest"],
          "properties": {
            "manifest_id": {"$ref": "common.schema.json#/$defs/id"},
            "manifest_digest": {"$ref": "common.schema.json#/$defs/digest"}
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollback_eligible_until", "minimum_retained_publications", "pinned_cursor_behavior_after_expiry"],
      "properties": {
        "rollback_eligible_until": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
        "minimum_retained_publications": {"type": "integer", "minimum": 2},
        "pinned_cursor_behavior_after_expiry": {"const": "restart_required"}
      }
    },
    "publication_digest": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/digest"},
        {"type": "object", "properties": {"domain": {"const": "publication_manifest"}}}
      ]
    },
    "sealed_at": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "immutable": {"const": true}
  }
}
