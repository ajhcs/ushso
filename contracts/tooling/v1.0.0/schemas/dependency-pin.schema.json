{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/tooling/v1.0.0/dependency-pin.schema.json",
  "title": "Contract tooling dependency and format pin",
  "type": "object",
  "additionalProperties": false,
  "required": ["pin_version", "package_version", "schema_draft", "module_system", "node_runtime", "dependencies", "formats", "immutable"],
  "properties": {
    "pin_version": {"const": "ushso.tooling-dependency-pin.v1"},
    "package_version": {"const": "1.0.0"},
    "schema_draft": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "module_system": {"const": "esm"},
    "node_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "tested"],
      "properties": {
        "minimum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major", "minor", "patch"],
          "properties": {
            "major": {"const": 22},
            "minor": {"const": 12},
            "patch": {"const": 0}
          }
        },
        "tested": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "purpose"],
        "properties": {
          "name": {"const": "ajv"},
          "version": {"const": "8.20.0"},
          "purpose": {"const": "json-schema-draft-2020-12-validation"}
        }
      }
    },
    "formats": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": ["date", "date-time", "time", "uri", "https-uri", "uuid", "sha256-hex", "json-pointer", "semver", "media-type"]
      }
    },
    "immutable": {"const": true}
  }
}
