{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushso.local/contracts/tooling/v1.0.0/fixture-manifest.schema.json",
  "title": "Valid and adversarial fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_manifest_version", "package_version", "offline", "entries", "immutable"],
  "properties": {
    "fixture_manifest_version": {"const": "ushso.fixture-manifest.v1"},
    "package_version": {"type": "string", "format": "semver", "minLength": 5, "maxLength": 64},
    "offline": {"const": true},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "schema_id", "expectation", "expected_rejection", "semantic_validator"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/Identifier"},
          "path": {"$ref": "common.schema.json#/$defs/SafeRelativePath"},
          "schema_id": {"$ref": "common.schema.json#/$defs/SchemaId"},
          "expectation": {"enum": ["valid", "rejected"]},
          "expected_rejection": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["phase", "code"],
                "properties": {
                  "phase": {"enum": ["parse", "schema", "semantic", "runner"]},
                  "code": {
                    "oneOf": [
                      {"type": "null"},
                      {"type": "string", "minLength": 1, "maxLength": 128}
                    ]
                  }
                }
              }
            ]
          },
          "semantic_validator": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "common.schema.json#/$defs/Identifier"}
            ]
          }
        },
        "allOf": [
          {
            "if": {"type": "object", "properties": {"expectation": {"const": "valid"}}},
            "then": {"type": "object", "properties": {"expected_rejection": {"type": "null"}}},
            "else": {"type": "object", "properties": {"expected_rejection": {"not": {"type": "null"}}}}
          }
        ]
      }
    },
    "immutable": {"const": true}
  }
}
