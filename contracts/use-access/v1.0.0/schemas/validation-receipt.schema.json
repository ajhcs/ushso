{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackyard.local/observatory/use-access/v1.0.0/validation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "package_version", "mode", "offline", "valid", "schema_count", "source_truth_count", "use_card_count", "access_recipe_count", "positive_check_count", "negative_check_count", "failed_count", "external_requests", "payload_downloads", "identity_merges", "coverage_executions", "lock_touches", "authorization_present", "execution_allowed", "dependency_pin_verified", "manifest_verified", "manifest_sha256", "checks", "errors", "immutable"],
  "properties": {
    "receipt_version": {"const": "use-access-validation.v1"},
    "package_version": {"const": "1.0.0"},
    "mode": {"const": "fixture_offline"},
    "offline": {"const": true},
    "valid": {"type": "boolean"},
    "schema_count": {"type": "integer", "minimum": 1},
    "source_truth_count": {"const": 3},
    "use_card_count": {"const": 3},
    "access_recipe_count": {"const": 3},
    "positive_check_count": {"type": "integer", "minimum": 1},
    "negative_check_count": {"type": "integer", "minimum": 1},
    "failed_count": {"type": "integer", "minimum": 0},
    "external_requests": {"const": 0},
    "payload_downloads": {"const": 0},
    "identity_merges": {"const": 0},
    "coverage_executions": {"const": 0},
    "lock_touches": {"const": 0},
    "authorization_present": {"const": false},
    "execution_allowed": {"const": false},
    "dependency_pin_verified": {"type": "boolean"},
    "manifest_verified": {"type": "boolean"},
    "manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "immutable": {"const": true}
  }
}
